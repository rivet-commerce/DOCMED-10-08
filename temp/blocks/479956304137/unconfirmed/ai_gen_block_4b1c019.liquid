{% doc %}
  @prompt
    Create a responsive Global Reach section for the DocMed About Us page based on the attached reference.
    
    Desktop
    
    Use a 35/65 two-column layout:
    
    Left – 35%
    
    Eyebrow: WELTWEIT WACHSEN. PERSÖNLICH BLEIBEN.
    Heading: In mehr als 50 Ländern
    Short body text
    Below, 3 statistics horizontally:
    50+ Länder weltweit
    1000+ Zufriedene Kunden
    10000+ Produkte im Sortiment
    Use subtle separators between the statistics.
    
    Right – 65%
    
    One large image taking 65% of the section width
    I will upload the image myself; do not generate one.
    Add a Shopify image picker.
    Allow cover or contain.
    Keep the image responsive and undistorted.
    Responsive
    Desktop: 35% text / 65% image
    Tablet: approximately 40% / 60%
    Mobile: stack vertically in this order: eyebrow → heading → text → statistics → image
    Image becomes 100% width on mobile.
    Statistics should remain in one row where possible and stack automatically on very small screens.
    No horizontal scrolling, overlapping or clipped content.
    Shopify
    
    Make all text, statistics and the image editable in the Theme Editor and compatible with Shopify translations / Translate & Adapt.
    
    Use the existing DocMed typography, colors, spacing and border radius. Keep the design clean, minimal and consistent with the other About Us sections., Create a responsive image + text section for the DocMed About Us page based on the attached layout.
    
    Layout
    
    Keep exactly this general format:
    
    Content centered within the normal DocMed page width.
    Left: Image – 70% width
    Right: Text – 30% width
    Image and text vertically centered.
    Keep a clean gap between both columns.
    Left – 70%
    Large image area with Shopify image picker.
    I will upload the image myself.
    Do not generate an image.
    Image should fill the available area without distortion.
    Use object-fit: cover.
    Slight rounded corners matching the DocMed theme.
    Right – 30%
    
    Eyebrow:
    
    UNSER UNTERNEHMEN
    
    Heading:
    
    International verwurzelt.
    Persönlich verbunden.
    
    Below this, display the existing two paragraphs.
    
    Responsive
    Desktop: strict 70% image / 30% text layout.
    Tablet: approximately 60% image / 40% text if necessary for readability.
    Mobile: stack vertically with image first, text underneath, both 100% width.
    No horizontal scrolling, overlapping or clipped content.
    
    Make the image, eyebrow, heading and text editable in the Shopify Theme Editor and compatible with Shopify translations.
    
    Use the existing DocMed typography, colors, spacing and responsive breakpoints.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-about-media-text-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }}}.ai-about-media-text__inner-{{ ai_gen_id }}{display:grid;grid-template-columns:70fr 30fr;align-items:center;gap:{{ block.settings.column_gap }}px}.ai-about-media-text__media-{{ ai_gen_id }}{position:relative;min-width:0;overflow:hidden;border-radius:{{ block.settings.image_radius }}px;background:{{ block.settings.placeholder_color }};aspect-ratio:{{ block.settings.image_ratio }}}.ai-about-media-text__media-{{ ai_gen_id }} img{display:block;width:100%;height:100%;object-fit:cover}.ai-about-media-text__placeholder-{{ ai_gen_id }}{display:flex;position:absolute;inset:0;align-items:center;justify-content:center}.ai-about-media-text__placeholder-{{ ai_gen_id }} svg{width:100%;height:100%;max-width:500px;max-height:500px;opacity:.35}.ai-about-media-text__content-{{ ai_gen_id }}{min-width:0}.ai-about-media-text__eyebrow-{{ ai_gen_id }}{margin:0 0 18px;color:{{ block.settings.accent_color }};font-size:12px;font-weight:700;letter-spacing:.12em;line-height:1.4;text-transform:uppercase}.ai-about-media-text__heading-{{ ai_gen_id }}{margin:0 0 24px;color:{{ block.settings.text_color }};font-size:clamp(28px,3vw,48px);font-weight:600;line-height:1.1;letter-spacing:-.02em}.ai-about-media-text__text-{{ ai_gen_id }}{color:{{ block.settings.body_color }};font-size:16px;line-height:1.7}.ai-about-media-text__text-{{ ai_gen_id }} p{margin:0 0 18px}.ai-about-media-text__text-{{ ai_gen_id }} p:last-child{margin-bottom:0}@media(max-width:989px){.ai-about-media-text__inner-{{ ai_gen_id }}{grid-template-columns:60fr 40fr;gap:{{ block.settings.column_gap | times: 0.75 }}px}}@media(max-width:749px){.ai-about-media-text__inner-{{ ai_gen_id }}{display:flex;flex-direction:column;align-items:stretch;gap:{{ block.settings.mobile_gap }}px}.ai-about-media-text__media-{{ ai_gen_id }},.ai-about-media-text__content-{{ ai_gen_id }}{width:100%}.ai-about-media-text__media-{{ ai_gen_id }}{aspect-ratio:{{ block.settings.mobile_image_ratio }}}}
{% endstyle %}
<div class="ai-about-media-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-about-media-text__inner-{{ ai_gen_id }}"><div class="ai-about-media-text__media-{{ ai_gen_id }}">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-about-media-text__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-about-media-text__content-{{ ai_gen_id }}">{% if block.settings.eyebrow != blank %}<p class="ai-about-media-text__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-about-media-text__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>{% endif %}<div class="ai-about-media-text__text-{{ ai_gen_id }}">{{ block.settings.text }}</div></div></div></div>
{% schema %}{"name":"About media and text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"UNSER UNTERNEHMEN"},{"type":"text","id":"heading","label":"Heading","default":"International verwurzelt. Persönlich verbunden."},{"type":"richtext","id":"text","label":"Text","default":"<p>DocMed steht für hochwertige medizinische Produkte, fundierte Beratung und eine zuverlässige Partnerschaft.</p><p>Von unserem Standort in Deutschland aus verbinden wir internationale Perspektiven mit persönlicher Nähe.</p>"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"column_gap","label":"Column gap","min":10,"max":80,"step":5,"unit":"px","default":40},{"type":"range","id":"mobile_gap","label":"Mobile gap","min":10,"max":60,"step":5,"unit":"px","default":30},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"4 / 3","label":"Landscape"},{"value":"1 / 1","label":"Square"},{"value":"3 / 4","label":"Portrait"}],"default":"4 / 3"},{"type":"select","id":"mobile_image_ratio","label":"Mobile image ratio","options":[{"value":"4 / 3","label":"Landscape"},{"value":"1 / 1","label":"Square"}],"default":"4 / 3"},{"type":"header","content":"Style"},{"type":"range","id":"image_radius","label":"Image radius","min":0,"max":40,"step":2,"unit":"px","default":8},{"type":"color","id":"text_color","label":"Heading color","default":"#1d2e40"},{"type":"color","id":"body_color","label":"Body color","default":"#435466"},{"type":"color","id":"accent_color","label":"Accent color","default":"#126fd3"},{"type":"color","id":"placeholder_color","label":"Placeholder color","default":"#eef3f5"}],"presets":[{"name":"About media and text"}],"tag":null,"class":"about-media-text-block"}{% endschema %}