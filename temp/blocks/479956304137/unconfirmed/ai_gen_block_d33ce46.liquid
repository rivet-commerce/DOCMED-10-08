{% doc %}
  @prompt
    Create a responsive Global Reach section for the DocMed About Us page based on the attached reference.
    
    Desktop
    
    Use a 35/65 two-column layout:
    
    Left – 35%
    
    Eyebrow: WELTWEIT WACHSEN. PERSÖNLICH BLEIBEN.
    Heading: In mehr als 50 Ländern
    Short body text
    Below, 3 statistics horizontally:
    50+ Länder weltweit
    1000+ Zufriedene Kunden
    10000+ Produkte im Sortiment
    Use subtle separators between the statistics.
    
    Right – 65%
    
    One large image taking 65% of the section width
    I will upload the image myself; do not generate one.
    Add a Shopify image picker.
    Allow cover or contain.
    Keep the image responsive and undistorted.
    Responsive
    Desktop: 35% text / 65% image
    Tablet: approximately 40% / 60%
    Mobile: stack vertically in this order: eyebrow → heading → text → statistics → image
    Image becomes 100% width on mobile.
    Statistics should remain in one row where possible and stack automatically on very small screens.
    No horizontal scrolling, overlapping or clipped content.
    Shopify
    
    Make all text, statistics and the image editable in the Theme Editor and compatible with Shopify translations / Translate & Adapt.
    
    Use the existing DocMed typography, colors, spacing and border radius. Keep the design clean, minimal and consistent with the other About Us sections.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-global-reach-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};border-radius:{{ block.settings.border_radius }}px;overflow:hidden}.ai-global-reach__inner-{{ ai_gen_id }}{display:grid;grid-template-columns:35fr 65fr;min-height:{{ block.settings.min_height }}px}.ai-global-reach__content-{{ ai_gen_id }}{display:flex;flex-direction:column;justify-content:center;padding:{{ block.settings.content_padding }}px;min-width:0}.ai-global-reach__eyebrow-{{ ai_gen_id }}{margin:0 0 18px;color:{{ block.settings.accent_color }};font-size:12px;font-weight:700;letter-spacing:.12em;line-height:1.4;text-transform:uppercase}.ai-global-reach__heading-{{ ai_gen_id }}{margin:0 0 18px;color:{{ block.settings.text_color }};font-size:clamp(30px,3.2vw,54px);font-weight:600;line-height:1.08}.ai-global-reach__body-{{ ai_gen_id }}{max-width:440px;margin:0;color:{{ block.settings.body_color }};font-size:16px;line-height:1.65}.ai-global-reach__body-{{ ai_gen_id }} p{margin:0}.ai-global-reach__stats-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:48px}.ai-global-reach__stat-{{ ai_gen_id }}{min-width:0;padding:0 18px;border-left:1px solid {{ block.settings.separator_color }}}.ai-global-reach__stat-{{ ai_gen_id }}:first-child{padding-left:0;border-left:0}.ai-global-reach__stat-value-{{ ai_gen_id }}{display:block;margin-bottom:7px;color:{{ block.settings.text_color }};font-size:clamp(20px,2vw,30px);font-weight:600}.ai-global-reach__stat-label-{{ ai_gen_id }}{display:block;color:{{ block.settings.body_color }};font-size:12px;line-height:1.35}.ai-global-reach__media-{{ ai_gen_id }}{position:relative;min-height:100%;background:{{ block.settings.image_placeholder_color }}}.ai-global-reach__media-{{ ai_gen_id }} img{display:block;width:100%;height:100%;min-height:{{ block.settings.min_height }}px;object-fit:{{ block.settings.image_fit }}}.ai-global-reach__placeholder-{{ ai_gen_id }}{display:flex;position:absolute;inset:0;align-items:center;justify-content:center;min-height:{{ block.settings.min_height }}px;padding:24px;text-align:center}.ai-global-reach__placeholder-{{ ai_gen_id }} svg{width:100%;height:100%;max-width:420px;max-height:420px;opacity:.35}.ai-global-reach__empty-{{ ai_gen_id }}{position:absolute;bottom:20px;left:50%;width:calc(100% - 40px);transform:translateX(-50%);font-size:13px}@media(max-width:989px){.ai-global-reach__inner-{{ ai_gen_id }}{grid-template-columns:40fr 60fr}.ai-global-reach__content-{{ ai_gen_id }}{padding:{{ block.settings.content_padding | times: 0.75 }}px}}@media(max-width:749px){.ai-global-reach__inner-{{ ai_gen_id }}{display:flex;flex-direction:column}.ai-global-reach__content-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px}.ai-global-reach__media-{{ ai_gen_id }}{min-height:0;aspect-ratio:4/3}.ai-global-reach__media-{{ ai_gen_id }} img,.ai-global-reach__placeholder-{{ ai_gen_id }}{min-height:0}}@media(max-width:420px){.ai-global-reach__stats-{{ ai_gen_id }}{grid-template-columns:1fr;gap:16px}.ai-global-reach__stat-{{ ai_gen_id }},.ai-global-reach__stat-{{ ai_gen_id }}:first-child{padding:0 0 0 14px;border-left:1px solid {{ block.settings.separator_color }}}}{% endstyle %}
<div class="ai-global-reach-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-global-reach__inner-{{ ai_gen_id }}"><div class="ai-global-reach__content-{{ ai_gen_id }}"><p class="ai-global-reach__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p><h2 class="ai-global-reach__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2><div class="ai-global-reach__body-{{ ai_gen_id }}">{{ block.settings.body }}</div><div class="ai-global-reach__stats-{{ ai_gen_id }}"><div class="ai-global-reach__stat-{{ ai_gen_id }}"><span class="ai-global-reach__stat-value-{{ ai_gen_id }}">{{ block.settings.stat_1_value }}</span><span class="ai-global-reach__stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</span></div><div class="ai-global-reach__stat-{{ ai_gen_id }}"><span class="ai-global-reach__stat-value-{{ ai_gen_id }}">{{ block.settings.stat_2_value }}</span><span class="ai-global-reach__stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</span></div><div class="ai-global-reach__stat-{{ ai_gen_id }}"><span class="ai-global-reach__stat-value-{{ ai_gen_id }}">{{ block.settings.stat_3_value }}</span><span class="ai-global-reach__stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</span></div></div></div><div class="ai-global-reach__media-{{ ai_gen_id }}">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-global-reach__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}<span class="ai-global-reach__empty-{{ ai_gen_id }}">{{ block.settings.image_empty_text }}</span></div>{% endif %}</div></div></div>
{% schema %}{"name":"Global reach","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WELTWEIT WACHSEN. PERSÖNLICH BLEIBEN."},{"type":"text","id":"heading","label":"Heading","default":"In mehr als 50 Ländern"},{"type":"richtext","id":"body","label":"Body text","default":"<p>Wir verbinden medizinische Expertise mit persönlicher Beratung und zuverlässiger Versorgung – weltweit und immer nah an unseren Kunden.</p>"},{"type":"text","id":"stat_1_value","label":"Statistic 1 value","default":"50+"},{"type":"text","id":"stat_1_label","label":"Statistic 1 label","default":"Länder weltweit"},{"type":"text","id":"stat_2_value","label":"Statistic 2 value","default":"1000+"},{"type":"text","id":"stat_2_label","label":"Statistic 2 label","default":"Zufriedene Kunden"},{"type":"text","id":"stat_3_value","label":"Statistic 3 value","default":"10000+"},{"type":"text","id":"stat_3_label","label":"Statistic 3 label","default":"Produkte im Sortiment"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"cover","label":"Cover"},{"value":"contain","label":"Contain"}],"default":"cover"},{"type":"text","id":"image_empty_text","label":"Empty image text","default":"Add an image in the Theme Editor"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"min_height","label":"Minimum height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"range","id":"content_padding","label":"Content padding","min":20,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":20,"max":60,"step":5,"unit":"px","default":30},{"type":"range","id":"border_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":8},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Heading color","default":"#1d2e40"},{"type":"color","id":"body_color","label":"Body color","default":"#435466"},{"type":"color","id":"accent_color","label":"Accent color","default":"#126fd3"},{"type":"color","id":"separator_color","label":"Separators","default":"#d8e0e6"},{"type":"color","id":"image_placeholder_color","label":"Image placeholder","default":"#eef3f5"}],"presets":[{"name":"Global reach"}],"tag":null,"class":"global-reach-block"}{% endschema %}