{% doc %}
  @prompt
    Erstelle eine zweispaltige Über-uns-Section mit viel Weißraum und einem modernen, minimalistischen Layout.
    
    Auf Desktop nimmt die Section nahezu die gesamte Seitenbreite ein. Links befindet sich der Textbereich mit einer großen, fetten Überschrift und darunter zwei Fließtext-Absätzen. Rechts befindet sich ein großes rechteckiges Bild mit leicht abgerundeten Ecken. Text und Bild nehmen jeweils ungefähr 50 % der Breite ein und sind vertikal mittig ausgerichtet.
    
    Im Shopify-Editor müssen Überschrift, beide Texte und Bild bearbeitbar sein. Die Schriftgröße der Überschrift muss für Desktop und Mobile separat einstellbar sein.
    
    Auf Mobile werden die Bereiche untereinander dargestellt: Text oben, Bild darunter. Keine Buttons, Rahmen oder zusätzlichen Elemente.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-about-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_spacing }}px 0;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-about__inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: {{ block.settings.column_gap }}px;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 4vw;
  }

  .ai-about__content-{{ ai_gen_id }} {
    max-width: 620px;
  }

  .ai-about__heading-{{ ai_gen_id }} {
    margin: 0 0 28px;
    color: {{ block.settings.heading_color }};
    font-family: Poppins, sans-serif;
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .ai-about__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-family: Manrope, sans-serif;
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.75;
  }

  .ai-about__text-{{ ai_gen_id }} p {
    margin: 0 0 22px;
  }

  .ai-about__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-about__media-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1.18 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background: #eef2f3;
  }

  .ai-about__media-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-about__placeholder-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #5b6870;
  }

  .ai-about__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-about__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 18px;
    left: 50%;
    width: calc(100% - 36px);
    transform: translateX(-50%);
    color: #46545c;
    font-family: Manrope, sans-serif;
    font-size: 13px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-about-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_spacing }}px 0;
    }

    .ai-about__inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 38px;
      padding: 0 22px;
    }

    .ai-about__heading-{{ ai_gen_id }} {
      margin-bottom: 22px;
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-about__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size }}px;
    }

    .ai-about__media-{{ ai_gen_id }} {
      aspect-ratio: 1.12 / 1;
    }
  }
{% endstyle %}

<div class="ai-about-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-about__inner-{{ ai_gen_id }}">
    <div class="ai-about__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-about__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      <div class="ai-about__text-{{ ai_gen_id }}">
        {{ block.settings.text_one }}
        {{ block.settings.text_two }}
      </div>
    </div>

    <div class="ai-about__media-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-about__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-about__empty-state-{{ ai_gen_id }}">Bild im Theme-Editor hinzufügen</div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Über uns zweispaltig",
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Über uns"
    },
    {
      "type": "richtext",
      "id": "text_one",
      "label": "Erster Text",
      "default": "<p>Wir verbinden medizinische Kompetenz mit zuverlässigen Lösungen für den professionellen Alltag.</p>"
    },
    {
      "type": "richtext",
      "id": "text_two",
      "label": "Zweiter Text",
      "default": "<p>Unser Anspruch ist es, Qualität, Service und Vertrauen in jedem Schritt erlebbar zu machen.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop-Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Überschrift Desktop",
      "min": 32,
      "max": 88,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Überschrift Mobile",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Textgröße",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Spaltenabstand",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Abstand Desktop",
      "min": 20,
      "max": 160,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "label": "Abstand Mobile",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Bildradius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Überschrift",
      "default": "#1d2e40"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d2e40"
    }
  ],
  "presets": [
    {
      "name": "Über uns zweispaltig"
    }
  ],
  "tag": null,
  "class": "about-two-column-block"
}
{% endschema %}