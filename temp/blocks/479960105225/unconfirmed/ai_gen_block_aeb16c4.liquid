{% doc %}
  @prompt
    Erstelle eine vollständig responsive Statement-Section mit einem modernen, minimalistischen Design und viel Weißraum.
    
    Oben steht eine kleine Eyebrow in Großbuchstaben, darunter eine große, fette Hauptüberschrift. Darunter befinden sich auf Desktop zwei gleich breite Textspalten, die durch eine feine vertikale Trennlinie voneinander getrennt sind. Keine Karten, Rahmen, Bilder oder zusätzlichen Elemente.
    
    Auf Mobile werden alle Inhalte untereinander dargestellt. Die vertikale Trennlinie wird zu einer horizontalen Linie zwischen den beiden Textblöcken. Alles muss sauber responsiv skalieren.
    
    Im Shopify-Editor möchte ich alles anpassen können: Section-Breite und -Höhe, Seitenabstand Desktop/Mobile, Padding oben/unten, Spaltenbreite und -abstand, Eyebrow-Größe, Überschriftgröße Desktop/Mobile, Textgröße Desktop/Mobile, Zeilenabstand, Hintergrundfarbe, alle Textfarben sowie Farbe und Stärke der Trennlinie.
    
    Wichtig: Die Section muss dasselbe Content-Raster und exakt dieselben Seitenabstände wie die anderen Sections verwenden, damit alle Sections untereinander auf einer Linie ausgerichtet sind.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-statement-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.body_color }};min-height:{{ block.settings.section_height }}px}.ai-statement-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:{{ block.settings.content_max_width }}px;margin:0 auto;padding:{{ block.settings.padding_top }}px {{ block.settings.desktop_side_padding }}px {{ block.settings.padding_bottom }}px;box-sizing:border-box}.ai-statement-{{ ai_gen_id }}__eyebrow{margin:0 0 {{ block.settings.eyebrow_spacing }}px;color:{{ block.settings.eyebrow_color }};font-family:{{ block.settings.body_font.family }};font-size:{{ block.settings.eyebrow_size }}px;font-weight:700;letter-spacing:.14em;line-height:1.3;text-transform:uppercase}.ai-statement-{{ ai_gen_id }}__heading{max-width:900px;margin:0 0 {{ block.settings.heading_spacing }}px;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size_desktop }}px;font-weight:700;letter-spacing:-.025em;line-height:1.05}.ai-statement-{{ ai_gen_id }}__columns{display:grid;grid-template-columns:minmax(0,{{ block.settings.column_width }}fr) minmax(0,{{ block.settings.column_width }}fr);column-gap:{{ block.settings.column_gap }}px}.ai-statement-{{ ai_gen_id }}__text{margin:0;color:{{ block.settings.body_color }};font-family:{{ block.settings.body_font.family }};font-size:{{ block.settings.text_size_desktop }}px;line-height:{{ block.settings.line_height }}}.ai-statement-{{ ai_gen_id }}__text--second{border-left:{{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};padding-left:{{ block.settings.column_gap }}px}.ai-statement-{{ ai_gen_id }}__text p:first-child{margin-top:0}.ai-statement-{{ ai_gen_id }}__text p:last-child{margin-bottom:0}@media screen and (max-width:749px){.ai-statement-{{ ai_gen_id }}__inner{width:100%;padding:{{ block.settings.padding_top }}px {{ block.settings.mobile_side_padding }}px {{ block.settings.padding_bottom }}px}.ai-statement-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size_mobile }}px}.ai-statement-{{ ai_gen_id }}__columns{display:block}.ai-statement-{{ ai_gen_id }}__text{font-size:{{ block.settings.text_size_mobile }}px}.ai-statement-{{ ai_gen_id }}__text--second{margin-top:{{ block.settings.column_gap }}px;padding:{{ block.settings.column_gap }}px 0 0;border-top:{{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};border-left:0}}
{% endstyle %}
<div class="ai-statement-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-statement-{{ ai_gen_id }}__inner">{% if block.settings.eyebrow != blank %}<p class="ai-statement-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-statement-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-statement-{{ ai_gen_id }}__columns"><div class="ai-statement-{{ ai_gen_id }}__text">{{ block.settings.text_left }}</div><div class="ai-statement-{{ ai_gen_id }}__text ai-statement-{{ ai_gen_id }}__text--second">{{ block.settings.text_right }}</div></div></div></div>
{% schema %}{"name":"Statement section","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Unser Anspruch"},{"type":"text","id":"heading","label":"Heading","default":"Präzision schafft Vertrauen."},{"type":"richtext","id":"text_left","label":"Left text","default":"<p>Wir entwickeln Lösungen, die medizinische Qualität mit verlässlicher Alltagstauglichkeit verbinden.</p>"},{"type":"richtext","id":"text_right","label":"Right text","default":"<p>Von der Auswahl bis zur Anwendung begleiten wir unsere Kundinnen und Kunden mit Klarheit, Fachwissen und persönlichem Service.</p>"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"content_max_width","label":"Content width","min":1000,"max":1800,"step":50,"unit":"px","default":1500},{"type":"range","id":"section_height","label":"Section height","min":200,"max":1000,"step":20,"unit":"px","default":520},{"type":"range","id":"desktop_side_padding","label":"Desktop side padding","min":0,"max":120,"step":5,"unit":"px","default":20},{"type":"range","id":"mobile_side_padding","label":"Mobile side padding","min":12,"max":60,"step":4,"unit":"px","default":20},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":200,"step":10,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":200,"step":10,"unit":"px","default":80},{"type":"range","id":"column_width","label":"Column width","min":1,"max":3,"step":1,"default":1},{"type":"range","id":"column_gap","label":"Column gap","min":16,"max":120,"step":4,"unit":"px","default":56},{"type":"header","content":"Typography"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"poppins_n4"},{"type":"font_picker","id":"body_font","label":"Body font","default":"manrope_n4"},{"type":"range","id":"eyebrow_size","label":"Eyebrow size","min":9,"max":24,"step":1,"unit":"px","default":12},{"type":"range","id":"heading_size_desktop","label":"Heading size desktop","min":32,"max":100,"step":4,"unit":"px","default":64},{"type":"range","id":"heading_size_mobile","label":"Heading size mobile","min":24,"max":60,"step":2,"unit":"px","default":40},{"type":"range","id":"text_size_desktop","label":"Text size desktop","min":14,"max":28,"step":1,"unit":"px","default":18},{"type":"range","id":"text_size_mobile","label":"Text size mobile","min":14,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"line_height","label":"Line height","min":1,"max":2,"step":0.1,"default":1.6},{"type":"range","id":"eyebrow_spacing","label":"Eyebrow spacing","min":8,"max":40,"step":4,"unit":"px","default":16},{"type":"range","id":"heading_spacing","label":"Heading spacing","min":20,"max":80,"step":5,"unit":"px","default":45},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#1D2E40"},{"type":"color","id":"heading_color","label":"Heading","default":"#1D2E40"},{"type":"color","id":"body_color","label":"Body text","default":"#1D2E40"},{"type":"color","id":"divider_color","label":"Divider","default":"#C9D1D8"},{"type":"range","id":"divider_thickness","label":"Divider thickness","min":1,"max":5,"step":1,"unit":"px","default":1}],"presets":[{"name":"Statement section"}],"tag":null,"class":"statement-section-block"}{% endschema %}