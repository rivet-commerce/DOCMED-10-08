{% doc %}
  @prompt
    Die Section soll ausgewählte Blogartikel auf der Shopify-Startseite hochwertig und editorial darstellen. Ziel ist es, Fachkompetenz zu vermitteln, relevante Ratgeber sichtbar zu machen und Nutzer gezielt in den Blog weiterzuleiten.
    Desktop-Layout: Oben links steht eine kleine Kategoriezeile wie „DOCMED RATGEBER“ in uppercase mit leichtem Letterspacing. Darunter folgt die große Überschrift „Wissen & Ratgeber“ und eine kurze Beschreibung. Rechts oben befindet sich ein sekundärer CTA „Alle Beiträge ansehen →“.
    Darunter folgt ein asymmetrisches Kartenlayout: Links eine große Featured-Card für den wichtigsten Beitrag, rechts drei kleinere Blogkarten untereinander. Die große Karte besteht oben aus einem großen Artikelbild und darunter aus Kategorie, Titel, kurzem Teasertext und dem Link „Jetzt lesen →“. Optional kann oben im Bild ein Badge wie „Beliebter Beitrag“ eingeblendet werden.
    Die drei kleineren Karten rechts bestehen jeweils aus einem Vorschaubild links und Text rechts. Angezeigt werden Kategorie, Blogtitel, ein kurzer Teaser und „Jetzt lesen →“.
    Mobile: Die Section wird einspaltig dargestellt. Zuerst Überschrift und Beschreibung, danach die Featured-Card. Anschließend folgen die weiteren Beiträge als kompakte Cards untereinander. Der Button „Alle Beiträge ansehen“ steht entweder direkt unter der Einleitung oder am Ende der Section.
    Design: Sehr clean, hochwertig und medizinisch. Weißer bzw. sehr hellblauer Hintergrund, großzügiger Weißraum, dezente Borders und sehr leichte Schatten. Keine starken Farbflächen. DocMed CI verwenden: Dunkelblau #1D2E40, Türkis #7FC7CF, neutrales Dunkelgrau für Fließtext. Überschriften in Poppins, übrige Texte in Manrope. Abgerundete Cards ca. 12–16 px Radius.
    Dynamische Shopify-Einstellungen: Die Section soll im Theme Editor vollständig pflegbar sein. Einstellbar sollen sein: Eyebrow, Überschrift, Beschreibung, CTA-Text und CTA-Link. Für jeden Blogartikel sollen Artikel, Bild, Kategorie, Titel und Teaser automatisch aus Shopify übernommen werden können. Zusätzlich sollte auswählbar sein, welcher Beitrag als Featured Article angezeigt wird und wie viele weitere Beiträge erscheinen.
    Wichtig: Die Section soll nicht wie ein einfacher Blog-Grid wirken, sondern wie ein editorialer Ratgeber-Bereich mit einem klar hervorgehobenen Hauptartikel.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign featured_article = block.settings.featured_article %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 56px 24px;
    background: {{ block.settings.background_color }};
    color: #1D2E40;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
  }
  .ai-editorial-{{ ai_gen_id }} *,
  .ai-editorial-{{ ai_gen_id }} *::before,
  .ai-editorial-{{ ai_gen_id }} *::after { box-sizing: border-box; }
  .ai-editorial-{{ ai_gen_id }}__inner { max-width: 1320px; margin: 0 auto; }
  .ai-editorial-{{ ai_gen_id }}__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 30px; }
  .ai-editorial-{{ ai_gen_id }}__intro { max-width: 700px; }
  .ai-editorial-{{ ai_gen_id }}__eyebrow { margin: 0 0 10px; color: #27666D; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__heading { margin: 0; color: #1D2E40; font-family: {{ settings.type_header_font.family }}, sans-serif; font-size: clamp(30px, 4vw, 46px); line-height: 1.12; }
  .ai-editorial-{{ ai_gen_id }}__description { max-width: 620px; margin: 14px 0 0; color: #465460; font-size: 16px; line-height: 1.65; }
  .ai-editorial-{{ ai_gen_id }}__all-link, .ai-editorial-{{ ai_gen_id }}__read { color: #1D2E40; font-weight: 700; text-decoration: none; }
  .ai-editorial-{{ ai_gen_id }}__all-link { flex: 0 0 auto; padding: 11px 0; border-bottom: 1px solid #7FC7CF; }
  .ai-editorial-{{ ai_gen_id }}__all-link:hover, .ai-editorial-{{ ai_gen_id }}__read:hover { color: #27666D; }
  .ai-editorial-{{ ai_gen_id }}__layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 24px; align-items: stretch; }
  .ai-editorial-{{ ai_gen_id }}__card { overflow: hidden; border: 1px solid #E2E9EC; border-radius: 14px; background: #fff; box-shadow: 0 5px 18px rgba(29,46,64,.055); }
  .ai-editorial-{{ ai_gen_id }}__featured { display: flex; flex-direction: column; }
  .ai-editorial-{{ ai_gen_id }}__image { position: relative; overflow: hidden; background: #EFF6F7; }
  .ai-editorial-{{ ai_gen_id }}__featured .ai-editorial-{{ ai_gen_id }}__image { aspect-ratio: 1.72 / 1; }
  .ai-editorial-{{ ai_gen_id }}__image img, .ai-editorial-{{ ai_gen_id }}__image svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-editorial-{{ ai_gen_id }}__badge { position: absolute; top: 16px; left: 16px; padding: 7px 11px; border-radius: 999px; background: #1D2E40; color: #fff; font-size: 12px; font-weight: 700; }
  .ai-editorial-{{ ai_gen_id }}__body { padding: 22px 24px 24px; }
  .ai-editorial-{{ ai_gen_id }}__category { margin: 0 0 8px; color: #27666D; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__title { margin: 0; color: #1D2E40; font-family: {{ settings.type_header_font.family }}, sans-serif; font-size: 25px; line-height: 1.25; }
  .ai-editorial-{{ ai_gen_id }}__title a { color: inherit; text-decoration: none; }
  .ai-editorial-{{ ai_gen_id }}__excerpt { margin: 10px 0 14px; color: #465460; font-size: 14px; line-height: 1.6; }
  .ai-editorial-{{ ai_gen_id }}__read { display: inline-block; font-size: 14px; }
  .ai-editorial-{{ ai_gen_id }}__side { display: flex; flex-direction: column; gap: 16px; }
  .ai-editorial-{{ ai_gen_id }}__small { display: grid; grid-template-columns: minmax(125px, 38%) minmax(0, 1fr); min-height: 0; flex: 1; }
  .ai-editorial-{{ ai_gen_id }}__small .ai-editorial-{{ ai_gen_id }}__image { min-height: 150px; }
  .ai-editorial-{{ ai_gen_id }}__small .ai-editorial-{{ ai_gen_id }}__body { display: flex; flex-direction: column; justify-content: center; padding: 18px; }
  .ai-editorial-{{ ai_gen_id }}__small .ai-editorial-{{ ai_gen_id }}__title { font-size: 18px; }
  .ai-editorial-{{ ai_gen_id }}__small .ai-editorial-{{ ai_gen_id }}__excerpt { margin: 7px 0 10px; font-size: 13px; }
  .ai-editorial-{{ ai_gen_id }}__empty { padding: 30px; text-align: center; color: #465460; }
  @media (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} { padding: 38px 18px; }
    .ai-editorial-{{ ai_gen_id }}__head { display: block; margin-bottom: 22px; }
    .ai-editorial-{{ ai_gen_id }}__all-link { display: inline-block; margin-top: 16px; }
    .ai-editorial-{{ ai_gen_id }}__layout { grid-template-columns: 1fr; gap: 16px; }
    .ai-editorial-{{ ai_gen_id }}__side { gap: 12px; }
    .ai-editorial-{{ ai_gen_id }}__featured .ai-editorial-{{ ai_gen_id }}__image { aspect-ratio: 1.45 / 1; }
    .ai-editorial-{{ ai_gen_id }}__body { padding: 18px; }
    .ai-editorial-{{ ai_gen_id }}__title { font-size: 22px; }
    .ai-editorial-{{ ai_gen_id }}__small { grid-template-columns: 112px minmax(0, 1fr); }
    .ai-editorial-{{ ai_gen_id }}__small .ai-editorial-{{ ai_gen_id }}__image { min-height: 130px; }
    .ai-editorial-{{ ai_gen_id }}__small .ai-editorial-{{ ai_gen_id }}__body { padding: 13px; }
    .ai-editorial-{{ ai_gen_id }}__small .ai-editorial-{{ ai_gen_id }}__title { font-size: 16px; }
    .ai-editorial-{{ ai_gen_id }}__small .ai-editorial-{{ ai_gen_id }}__excerpt { display: none; }
  }
{% endstyle %}

<section class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    <div class="ai-editorial-{{ ai_gen_id }}__head">
      <div class="ai-editorial-{{ ai_gen_id }}__intro">
        {% if block.settings.eyebrow != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
        {% if block.settings.heading != blank %}<h2 class="ai-editorial-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.description != blank %}<div class="ai-editorial-{{ ai_gen_id }}__description">{{ block.settings.description | escape | newline_to_br }}</div>{% endif %}
      </div>
      {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__all-link" href="{{ block.settings.cta_link }}">{{ block.settings.cta_text | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>

    {% if featured_article != blank %}
      <div class="ai-editorial-{{ ai_gen_id }}__layout">
        <article class="ai-editorial-{{ ai_gen_id }}__card ai-editorial-{{ ai_gen_id }}__featured">
          <a class="ai-editorial-{{ ai_gen_id }}__image" href="{{ featured_article.url }}" aria-label="{{ featured_article.title | escape }}">
            {% if featured_article.image %}<img src="{{ featured_article.image | image_url: width: 1400 }}" alt="{{ featured_article.image.alt | default: featured_article.title | escape }}" loading="lazy" width="{{ featured_article.image.width }}" height="{{ featured_article.image.height }}">{% else %}<div class="ai-editorial-{{ ai_gen_id }}__image">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
            {% if block.settings.show_badge and block.settings.badge_text != blank %}<span class="ai-editorial-{{ ai_gen_id }}__badge">{{ block.settings.badge_text | escape }}</span>{% endif %}
          </a>
          <div class="ai-editorial-{{ ai_gen_id }}__body">
            {% if featured_article.tags.first != blank %}<p class="ai-editorial-{{ ai_gen_id }}__category">{{ featured_article.tags.first | escape }}</p>{% endif %}
            <h3 class="ai-editorial-{{ ai_gen_id }}__title"><a href="{{ featured_article.url }}">{{ featured_article.title | escape }}</a></h3>
            <p class="ai-editorial-{{ ai_gen_id }}__excerpt">{{ featured_article.excerpt_or_content | strip_html | truncate: 180 }}</p>
            <a class="ai-editorial-{{ ai_gen_id }}__read" href="{{ featured_article.url }}">{{ block.settings.read_label | escape }} <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <div class="ai-editorial-{{ ai_gen_id }}__side">
          {% assign displayed_count = 0 %}
          {% for article in block.settings.article_list %}
            {% if article != blank and article.id != featured_article.id and displayed_count < block.settings.additional_count %}
              {% assign displayed_count = displayed_count | plus: 1 %}
              <article class="ai-editorial-{{ ai_gen_id }}__card ai-editorial-{{ ai_gen_id }}__small">
                <a class="ai-editorial-{{ ai_gen_id }}__image" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
                  {% if article.image %}<img src="{{ article.image | image_url: width: 500 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}">{% else %}<div class="ai-editorial-{{ ai_gen_id }}__image">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
                </a>
                <div class="ai-editorial-{{ ai_gen_id }}__body">
                  {% if article.tags.first != blank %}<p class="ai-editorial-{{ ai_gen_id }}__category">{{ article.tags.first | escape }}</p>{% endif %}
                  <h3 class="ai-editorial-{{ ai_gen_id }}__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
                  <p class="ai-editorial-{{ ai_gen_id }}__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 92 }}</p>
                  <a class="ai-editorial-{{ ai_gen_id }}__read" href="{{ article.url }}">{{ block.settings.read_label | escape }} <span aria-hidden="true">→</span></a>
                </div>
              </article>
            {% endif %}
          {% endfor %}
          {% if displayed_count == 0 %}<div class="ai-editorial-{{ ai_gen_id }}__card ai-editorial-{{ ai_gen_id }}__empty">Wähle im Theme Editor weitere Blogartikel aus, um die Karten hier anzuzeigen.</div>{% endif %}
        </div>
      </div>
    {% else %}
      <div class="ai-editorial-{{ ai_gen_id }}__card ai-editorial-{{ ai_gen_id }}__empty">Wähle im Theme Editor einen Featured Article aus, um den Ratgeberbereich zu vervollständigen.</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Editorial blogbereich",
  "settings": [
    { "type": "header", "content": "Einleitung" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DOCMED RATGEBER" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Wissen & Ratgeber" },
    { "type": "textarea", "id": "description", "label": "Beschreibung", "default": "Fundiertes Wissen und praktische Orientierung für Diagnostik, Labor und medizinischen Alltag." },
    { "type": "text", "id": "cta_text", "label": "CTA-Text", "default": "Alle Beiträge ansehen" },
    { "type": "url", "id": "cta_link", "label": "CTA-Link" },
    { "type": "header", "content": "Artikel" },
    { "type": "article", "id": "featured_article", "label": "Featured Article" },
    { "type": "article_list", "id": "article_list", "label": "Weitere Artikel", "limit": 10 },
    { "type": "range", "id": "additional_count", "label": "Anzahl weiterer Beiträge", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "text", "id": "read_label", "label": "Linktext", "default": "Jetzt lesen" },
    { "type": "checkbox", "id": "show_badge", "label": "Featured-Badge anzeigen", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge-Text", "default": "Beliebter Beitrag" },
    { "type": "header", "content": "Darstellung" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Hintergrund", "default": "#F8FBFC" }
  ],
  "presets": [
    { "name": "Editorial blogbereich" }
  ],
  "tag": null,
  "class": "editorial-blog-block"
}
{% endschema %}