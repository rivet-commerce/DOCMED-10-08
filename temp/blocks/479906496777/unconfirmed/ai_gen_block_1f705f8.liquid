{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-about-{{ ai_gen_id }}{display:block;width:100%;max-width:100%;margin:0 auto;padding:{{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;color:{{ block.settings.text_color }}}.ai-about-{{ ai_gen_id }}__inner{width:100%;max-width:{{ block.settings.content_max_width }}px;margin:0 auto;display:grid;grid-template-columns:minmax(0,48fr) minmax(0,52fr);gap:{{ block.settings.column_gap }}px;align-items:center}.ai-about-{{ ai_gen_id }}__media{grid-column:1;grid-row:1;width:100%;aspect-ratio:1.18/1;overflow:hidden;border-radius:{{ block.settings.image_radius }}px;background:#eef3f5}.ai-about-{{ ai_gen_id }}__media img{display:block;width:100%;height:100%;object-fit:cover}.ai-about-{{ ai_gen_id }}__placeholder{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#74818b}.ai-about-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-about-{{ ai_gen_id }}__empty-state{position:absolute;bottom:18px;left:50%;width:calc(100% - 32px);transform:translateX(-50%);padding:8px 12px;border-radius:4px;background:rgba(255,255,255,.92);color:#354552;text-align:center;font-size:13px}.ai-about-{{ ai_gen_id }}__content{grid-column:2;grid-row:1;max-width:620px;padding:8px 0}.ai-about-{{ ai_gen_id }}__eyebrow{margin:0 0 18px;color:{{ block.settings.accent_color }};font-size:13px;font-weight:700;letter-spacing:.14em;line-height:1.4;text-transform:uppercase}.ai-about-{{ ai_gen_id }}__heading{margin:0 0 26px;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }},sans-serif;font-size:clamp(32px,3.1vw,52px);font-weight:700;letter-spacing:-.035em;line-height:1.08}.ai-about-{{ ai_gen_id }}__copy{max-width:590px;color:{{ block.settings.text_color }};font-family:{{ block.settings.body_font.family }},sans-serif;font-size:16px;line-height:1.75}.ai-about-{{ ai_gen_id }}__copy p{margin:0 0 18px}.ai-about-{{ ai_gen_id }}__copy p:last-child{margin-bottom:0}@media screen and (max-width:1100px){.ai-about-{{ ai_gen_id }}__inner{gap:35px;grid-template-columns:minmax(0,50fr) minmax(0,50fr)}.ai-about-{{ ai_gen_id }}__heading{font-size:clamp(30px,4vw,42px)}}@media screen and (max-width:749px){.ai-about-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding_top }}px 16px {{ block.settings.mobile_padding_bottom }}px}.ai-about-{{ ai_gen_id }}__inner{display:flex;flex-direction:column;align-items:stretch;gap:{{ block.settings.mobile_gap }}px}.ai-about-{{ ai_gen_id }}__media{order:1;aspect-ratio:1.45/1}.ai-about-{{ ai_gen_id }}__content{order:2;max-width:none;padding:0}.ai-about-{{ ai_gen_id }}__eyebrow{margin-bottom:14px;font-size:12px}.ai-about-{{ ai_gen_id }}__heading{margin-bottom:20px;font-size:clamp(30px,8vw,38px);line-height:1.12}.ai-about-{{ ai_gen_id }}__copy{font-size:15px;line-height:1.7}}
{% endstyle %}
<section class="ai-about-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-about-{{ ai_gen_id }}__inner"><div class="ai-about-{{ ai_gen_id }}__media">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | default: block.settings.image_alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">{% else %}<div class="ai-about-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<div class="ai-about-{{ ai_gen_id }}__empty-state">Füge ein Unternehmensbild hinzu</div></div>{% endif %}</div><div class="ai-about-{{ ai_gen_id }}__content"><p class="ai-about-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h2 class="ai-about-{{ ai_gen_id }}__heading">{{ block.settings.heading | newline_to_br }}</h2><div class="ai-about-{{ ai_gen_id }}__copy">{{ block.settings.body_copy }}</div></div></div></section>
