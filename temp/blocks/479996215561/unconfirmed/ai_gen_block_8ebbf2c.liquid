{% doc %}
  @prompt
    Erstelle eine vollständig responsive, zentrierte Motto-Section für die About-us-Seite.
    
    Oben steht mittig die große Überschrift „Global in unserem Ausmaß. Persönlich in unserem Ansatz.“. Es gibt keinen Eyebrow-Text und keinen zusätzlichen Beschreibungstext unter der Überschrift.
    
    Direkt unter der Überschrift befindet sich zentriert ein großes, frei auswählbares Bild des Globus.
    
    Unterhalb des Bildes befinden sich zwei gleich breite Informationsblöcke nebeneinander:
    
    Links: frei auswählbares Icon, darunter Überschrift „Global gedacht“ und darunter Beschreibungstext.
    
    Rechts: frei auswählbares Icon, darunter Überschrift „Persönlich begleitet“ und darunter Beschreibungstext.
    
    Beide Blöcke sind vollständig zentriert ausgerichtet. Zwischen ihnen befindet sich ausschließlich eine feine vertikale Trennlinie. Keine Karten, Rahmen oder Schatten.
    
    Die komplette Section liegt in einem zentrierten Content-Container mit maximal 1500 px Breite und muss exakt dieselbe Außenbreite wie die anderen Sections der Seite verwenden.
    
    Mobile: Überschrift oben, Globus darunter und anschließend die beiden Informationsblöcke untereinander. Die vertikale Trennlinie wird auf Mobile zu einer horizontalen Trennlinie. Alle Elemente bleiben zentriert und verwenden denselben mobilen Seitenabstand.
    
    Im Shopify-Editor muss alles anpassbar sein: Section-Breite (Standard 1500 px), Section-Höhe/Mindesthöhe, Seitenabstand Desktop/Mobile, Padding oben/unten, Überschriftgröße Desktop/Mobile, Überschriftfarbe, Bildbreite und Bildhöhe Desktop/Mobile, Abstand zwischen Überschrift/Bild/Informationsblöcken, Icon-Größe Desktop/Mobile, Icons selbst, beide Blocküberschriften und Texte, deren Schriftgrößen und Farben sowie Farbe, Stärke und Länge der Trennlinie.
    
    Die Section muss auf Desktop, Tablet und Mobile vollständig responsiv sein. Keine 100vw-Breiten oder zusätzlichen Wrapper verwenden, die den Inhalt über die eingestellte Content-Breite hinaus vergrößern.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-motto-{{ ai_gen_id }}{display:block;width:100%;max-width:{{ block.settings.content_width }}px;min-height:{{ block.settings.min_height }}px;margin:0 auto;padding:{{ block.settings.padding_top }}px {{ block.settings.desktop_side_padding }}px {{ block.settings.padding_bottom }}px;color:{{ block.settings.heading_color }};box-sizing:border-box}.ai-motto-{{ ai_gen_id }}__heading{margin:0;text-align:center;font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size_desktop }}px;line-height:1.12;font-weight:600}.ai-motto-{{ ai_gen_id }}__image-wrap{width:{{ block.settings.image_width_desktop }}%;height:{{ block.settings.image_height_desktop }}px;margin:{{ block.settings.heading_image_gap }}px auto 0;display:flex;align-items:center;justify-content:center;overflow:hidden}.ai-motto-{{ ai_gen_id }}__image-wrap img,.ai-motto-{{ ai_gen_id }}__image-wrap svg{width:100%;height:100%;object-fit:contain}.ai-motto-{{ ai_gen_id }}__placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center}.ai-motto-{{ ai_gen_id }}__placeholder svg{color:#65727d}.ai-motto-{{ ai_gen_id }}__info{display:grid;grid-template-columns:1fr 1px 1fr;align-items:stretch;margin-top:{{ block.settings.image_info_gap }}px}.ai-motto-{{ ai_gen_id }}__item{text-align:center;padding:0 {{ block.settings.info_horizontal_padding }}px}.ai-motto-{{ ai_gen_id }}__divider{width:{{ block.settings.divider_thickness }}px;height:{{ block.settings.divider_length }}%;min-height:80px;align-self:center;background:{{ block.settings.divider_color }}}.ai-motto-{{ ai_gen_id }}__icon{width:{{ block.settings.icon_size_desktop }}px;height:{{ block.settings.icon_size_desktop }}px;object-fit:contain;margin:0 auto {{ block.settings.icon_heading_gap }}px;display:block}.ai-motto-{{ ai_gen_id }}__icon-placeholder{width:{{ block.settings.icon_size_desktop }}px;height:{{ block.settings.icon_size_desktop }}px;margin:0 auto {{ block.settings.icon_heading_gap }}px;display:flex;align-items:center;justify-content:center}.ai-motto-{{ ai_gen_id }}__icon-placeholder svg{width:100%;height:100%;color:#65727d}.ai-motto-{{ ai_gen_id }}__title{margin:0 0 {{ block.settings.title_text_gap }}px;color:{{ block.settings.info_heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.info_heading_size }}px;line-height:1.25;font-weight:600}.ai-motto-{{ ai_gen_id }}__text{margin:0 auto;max-width:520px;color:{{ block.settings.info_text_color }};font-family:{{ block.settings.body_font.family }};font-size:{{ block.settings.info_text_size }}px;line-height:1.55}@media screen and (max-width:749px){.ai-motto-{{ ai_gen_id }}{padding-left:{{ block.settings.mobile_side_padding }}px;padding-right:{{ block.settings.mobile_side_padding }}px}.ai-motto-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size_mobile }}px}.ai-motto-{{ ai_gen_id }}__image-wrap{width:{{ block.settings.image_width_mobile }}%;height:{{ block.settings.image_height_mobile }}px}.ai-motto-{{ ai_gen_id }}__info{grid-template-columns:1fr;gap:{{ block.settings.mobile_info_gap }}px}.ai-motto-{{ ai_gen_id }}__divider{width:{{ block.settings.divider_length }}%;height:{{ block.settings.divider_thickness }}px;min-height:0;justify-self:center}.ai-motto-{{ ai_gen_id }}__icon,.ai-motto-{{ ai_gen_id }}__icon-placeholder{width:{{ block.settings.icon_size_mobile }}px;height:{{ block.settings.icon_size_mobile }}px}}
{% endstyle %}
<div class="ai-motto-{{ ai_gen_id }}" {{ block.shopify_attributes }}><h2 class="ai-motto-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2><div class="ai-motto-{{ ai_gen_id }}__image-wrap">{% if block.settings.globe_image %}<img src="{{ block.settings.globe_image | image_url: width: 1800 }}" alt="{{ block.settings.globe_image.alt | escape }}" loading="lazy">{% else %}<div class="ai-motto-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-motto-{{ ai_gen_id }}__info"><div class="ai-motto-{{ ai_gen_id }}__item">{% if block.settings.icon_one %}<img class="ai-motto-{{ ai_gen_id }}__icon" src="{{ block.settings.icon_one | image_url: width: 300 }}" alt="" loading="lazy">{% else %}<div class="ai-motto-{{ ai_gen_id }}__icon-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<h3 class="ai-motto-{{ ai_gen_id }}__title">{{ block.settings.title_one | escape }}</h3><div class="ai-motto-{{ ai_gen_id }}__text">{{ block.settings.text_one }}</div></div><div class="ai-motto-{{ ai_gen_id }}__divider" aria-hidden="true"></div><div class="ai-motto-{{ ai_gen_id }}__item">{% if block.settings.icon_two %}<img class="ai-motto-{{ ai_gen_id }}__icon" src="{{ block.settings.icon_two | image_url: width: 300 }}" alt="" loading="lazy">{% else %}<div class="ai-motto-{{ ai_gen_id }}__icon-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<h3 class="ai-motto-{{ ai_gen_id }}__title">{{ block.settings.title_two | escape }}</h3><div class="ai-motto-{{ ai_gen_id }}__text">{{ block.settings.text_two }}</div></div></div></div>
{% schema %}{"name":"Motto section","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"Global in unserem Ausmaß. Persönlich in unserem Ansatz."},{"type":"image_picker","id":"globe_image","label":"Globe image"},{"type":"image_picker","id":"icon_one","label":"Left icon"},{"type":"text","id":"title_one","label":"Left heading","default":"Global gedacht"},{"type":"richtext","id":"text_one","label":"Left description","default":"<p>Wir verbinden internationale Perspektiven mit zuverlässigen Lösungen.</p>"},{"type":"image_picker","id":"icon_two","label":"Right icon"},{"type":"text","id":"title_two","label":"Right heading","default":"Persönlich begleitet"},{"type":"richtext","id":"text_two","label":"Right description","default":"<p>Wir stehen Ihnen persönlich, kompetent und partnerschaftlich zur Seite.</p>"},{"type":"header","content":"Layout"},{"type":"range","id":"content_width","label":"Content width","min":1000,"max":1800,"step":50,"unit":"px","default":1500},{"type":"range","id":"min_height","label":"Minimum height","min":300,"max":1400,"step":50,"unit":"px","default":700},{"type":"range","id":"desktop_side_padding","label":"Desktop side padding","min":0,"max":100,"step":5,"unit":"px","default":20},{"type":"range","id":"mobile_side_padding","label":"Mobile side padding","min":10,"max":50,"step":5,"unit":"px","default":20},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":10,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":10,"unit":"px","default":80},{"type":"range","id":"heading_image_gap","label":"Heading to image gap","min":10,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"image_info_gap","label":"Image to info gap","min":10,"max":120,"step":5,"unit":"px","default":60},{"type":"range","id":"mobile_info_gap","label":"Mobile info gap","min":20,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"info_horizontal_padding","label":"Info side padding","min":0,"max":80,"step":5,"unit":"px","default":20},{"type":"header","content":"Typography"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"poppins_n4"},{"type":"font_picker","id":"body_font","label":"Body font","default":"manrope_n4"},{"type":"range","id":"heading_size_desktop","label":"Heading size desktop","min":24,"max":80,"step":4,"unit":"px","default":52},{"type":"range","id":"heading_size_mobile","label":"Heading size mobile","min":20,"max":48,"step":2,"unit":"px","default":30},{"type":"color","id":"heading_color","label":"Heading color","default":"#1d2e40"},{"type":"range","id":"info_heading_size","label":"Info heading size","min":16,"max":36,"step":2,"unit":"px","default":24},{"type":"range","id":"info_text_size","label":"Info text size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"color","id":"info_heading_color","label":"Info heading color","default":"#1d2e40"},{"type":"color","id":"info_text_color","label":"Info text color","default":"#1d2e40"},{"type":"range","id":"icon_heading_gap","label":"Icon to heading gap","min":5,"max":40,"step":5,"unit":"px","default":15},{"type":"range","id":"title_text_gap","label":"Heading to text gap","min":5,"max":30,"step":5,"unit":"px","default":10},{"type":"header","content":"Media and divider"},{"type":"range","id":"image_width_desktop","label":"Image width desktop","min":20,"max":100,"step":5,"unit":"%","default":70},{"type":"range","id":"image_width_mobile","label":"Image width mobile","min":40,"max":100,"step":5,"unit":"%","default":90},{"type":"range","id":"image_height_desktop","label":"Image height desktop","min":100,"max":800,"step":25,"unit":"px","default":425},{"type":"range","id":"image_height_mobile","label":"Image height mobile","min":100,"max":500,"step":25,"unit":"px","default":275},{"type":"range","id":"icon_size_desktop","label":"Icon size desktop","min":24,"max":160,"step":8,"unit":"px","default":72},{"type":"range","id":"icon_size_mobile","label":"Icon size mobile","min":24,"max":120,"step":8,"unit":"px","default":56},{"type":"color","id":"divider_color","label":"Divider color","default":"#b8c2c9"},{"type":"range","id":"divider_thickness","label":"Divider thickness","min":1,"max":6,"step":1,"unit":"px","default":1},{"type":"range","id":"divider_length","label":"Divider length","min":20,"max":100,"step":5,"unit":"%","default":70}],"presets":[{"name":"Motto section"}],"tag":null,"class":"motto-section-block"}{% endschema %}