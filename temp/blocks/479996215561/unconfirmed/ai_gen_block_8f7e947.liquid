{% doc %}
  @prompt
    Erstelle eine komplett neue responsive „Mission & Vision“-Section.
    
    Die Section besteht auf Desktop aus exakt zwei gleich breiten Spalten (50/50).
    
    Linke Spalte – Mission: Oben ein frei auswählbares Icon, darunter ein kleines Label „Unsere Mission“, anschließend eine große Überschrift und darunter ein frei bearbeitbarer Rich-Text mit mehreren Absätzen.
    
    Rechte Spalte – Vision: Oben ein frei auswählbares Icon, darunter ein kleines Label „Unsere Vision“, anschließend eine große Überschrift und darunter ein frei bearbeitbarer Rich-Text mit mehreren Absätzen.
    
    Zwischen beiden Spalten befindet sich eine einzige feine vertikale Trennlinie exakt in der Mitte. Es gibt keine äußere Umrandung, keine zweite Linie rechts oder links, keine Karten und keine Schatten.
    
    Der gesamte Inhalt liegt in einem zentrierten Container mit maximal 1500 px Breite. Beide Spalten müssen exakt gleich breit sein und identische Innenabstände besitzen.
    
    Mobile: Die beiden Bereiche werden untereinander dargestellt. Zuerst Mission, darunter Vision. Die vertikale Linie wird durch eine horizontale Trennlinie zwischen den beiden Bereichen ersetzt. Beide Bereiche nutzen exakt dieselbe mobile Breite und denselben Seitenabstand.
    
    Im Shopify-Editor muss alles anpassbar sein: maximale Section-Breite (Standard 1500 px), Section-Höhe/Mindesthöhe, Hintergrundfarbe, Seitenabstand Desktop/Tablet/Mobile, Padding oben/unten, Abstand zwischen den Spalten, Innenabstand zur Mittellinie, Icon-Auswahl, Icon-Größe Desktop/Mobile, Label-Text/-Farbe/-Größe, Überschrift/-Farbe/-Größe Desktop/Mobile, Fließtext/-Farbe/-Größe Desktop/Mobile, Zeilenhöhe sowie Farbe und Stärke der Trennlinie.
    
    Die Section muss vollständig responsiv für Desktop, Tablet und Mobile sein. Keine 100vw-Breiten oder zusätzlichen Wrapper verwenden. Die gesamte sichtbare Content-Breite darf 1500 px nicht überschreiten.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-mission-vision-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};min-height:{{ block.settings.min_height }}px;padding:{{ block.settings.padding_vertical }}px {{ block.settings.desktop_side_padding }}px;color:{{ block.settings.body_color }}}
.ai-mission-vision__container-{{ ai_gen_id }}{width:100%;max-width:{{ block.settings.max_width }}px;margin:0 auto}
.ai-mission-vision__grid-{{ ai_gen_id }}{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:{{ block.settings.column_gap }}px}
.ai-mission-vision__item-{{ ai_gen_id }}{min-width:0;padding:0 {{ block.settings.inner_padding }}px}
.ai-mission-vision__item-{{ ai_gen_id }}+.ai-mission-vision__item-{{ ai_gen_id }}{border-left:{{ block.settings.divider_width }}px solid {{ block.settings.divider_color }}}
.ai-mission-vision__icon-{{ ai_gen_id }}{width:{{ block.settings.icon_size }}px;height:{{ block.settings.icon_size }}px;display:flex;align-items:center;justify-content:center;color:{{ block.settings.icon_color }};margin-bottom:20px}
.ai-mission-vision__icon-{{ ai_gen_id }} svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.ai-mission-vision__label-{{ ai_gen_id }}{margin:0 0 12px;color:{{ block.settings.label_color }};font-size:{{ block.settings.label_size }}px;line-height:1.3;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.ai-mission-vision__heading-{{ ai_gen_id }}{margin:0 0 22px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.15;font-weight:700}
.ai-mission-vision__text-{{ ai_gen_id }}{color:{{ block.settings.body_color }};font-size:{{ block.settings.body_size }}px;line-height:{{ block.settings.body_line_height }}}
.ai-mission-vision__text-{{ ai_gen_id }} p{margin:0 0 1em}.ai-mission-vision__text-{{ ai_gen_id }} p:last-child{margin-bottom:0}
@media screen and (max-width:989px){.ai-mission-vision-{{ ai_gen_id }}{padding-left:{{ block.settings.tablet_side_padding }}px;padding-right:{{ block.settings.tablet_side_padding }}px}.ai-mission-vision__item-{{ ai_gen_id }}{padding-left:{{ block.settings.inner_padding | times:0.75 | round }}px;padding-right:{{ block.settings.inner_padding | times:0.75 | round }}px}}
@media screen and (max-width:749px){.ai-mission-vision-{{ ai_gen_id }}{padding-top:{{ block.settings.padding_vertical | times:0.8 | round }}px;padding-bottom:{{ block.settings.padding_vertical | times:0.8 | round }}px}.ai-mission-vision__grid-{{ ai_gen_id }}{display:block}.ai-mission-vision__item-{{ ai_gen_id }}{padding:0}.ai-mission-vision__item-{{ ai_gen_id }}+.ai-mission-vision__item-{{ ai_gen_id }}{border-left:0;border-top:{{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};margin-top:{{ block.settings.column_gap }}px;padding-top:{{ block.settings.column_gap }}px}.ai-mission-vision__icon-{{ ai_gen_id }}{width:{{ block.settings.icon_size_mobile }}px;height:{{ block.settings.icon_size_mobile }}px}.ai-mission-vision__heading-{{ ai_gen_id }}{font-size:{{ block.settings.heading_size_mobile }}px}.ai-mission-vision__text-{{ ai_gen_id }}{font-size:{{ block.settings.body_size_mobile }}px}.ai-mission-vision-{{ ai_gen_id }}{padding-left:{{ block.settings.mobile_side_padding }}px;padding-right:{{ block.settings.mobile_side_padding }}px}}
{% endstyle %}
<div class="ai-mission-vision-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-mission-vision__container-{{ ai_gen_id }}"><div class="ai-mission-vision__grid-{{ ai_gen_id }}">{% for side in (1..2) %}{% if side == 1 %}{% assign icon=block.settings.mission_icon %}{% assign label=block.settings.mission_label %}{% assign heading=block.settings.mission_heading %}{% assign content=block.settings.mission_text %}{% else %}{% assign icon=block.settings.vision_icon %}{% assign label=block.settings.vision_label %}{% assign heading=block.settings.vision_heading %}{% assign content=block.settings.vision_text %}{% endif %}<article class="ai-mission-vision__item-{{ ai_gen_id }}"><div class="ai-mission-vision__icon-{{ ai_gen_id }}" aria-hidden="true">{% case icon %}{% when 'target' %}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>{% when 'eye' %}<svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>{% when 'heart' %}<svg viewBox="0 0 24 24"><path d="M20.8 8.7c0 5-8.8 10.3-8.8 10.3S3.2 13.7 3.2 8.7A4.7 4.7 0 0 1 12 6.2a4.7 4.7 0 0 1 8.8 2.5Z"/></svg>{% when 'star' %}<svg viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>{% when 'compass' %}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2.2 4.8-4.8 2.2 2.2-4.8 4.8-2.2Z"/></svg>{% endcase %}</div><p class="ai-mission-vision__label-{{ ai_gen_id }}">{{ label | escape }}</p><h2 class="ai-mission-vision__heading-{{ ai_gen_id }}">{{ heading | escape }}</h2><div class="ai-mission-vision__text-{{ ai_gen_id }}">{{ content }}</div></article>{% endfor %}</div></div></div>
{% schema %}{"name":"Mission & Vision","settings":[{"type":"header","content":"Layout"},{"type":"range","id":"max_width","label":"Max width","min":800,"max":1500,"step":50,"unit":"px","default":1500},{"type":"range","id":"min_height","label":"Minimum height","min":200,"max":900,"step":25,"unit":"px","default":450},{"type":"range","id":"column_gap","label":"Column gap","min":0,"max":120,"step":5,"unit":"px","default":40},{"type":"range","id":"inner_padding","label":"Inner padding","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"padding_vertical","label":"Top and bottom padding","min":0,"max":160,"step":10,"unit":"px","default":80},{"type":"range","id":"desktop_side_padding","label":"Desktop side padding","min":0,"max":100,"step":5,"unit":"px","default":30},{"type":"range","id":"tablet_side_padding","label":"Tablet side padding","min":0,"max":80,"step":5,"unit":"px","default":25},{"type":"range","id":"mobile_side_padding","label":"Mobile side padding","min":0,"max":50,"step":5,"unit":"px","default":20},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"header","content":"Mission"},{"type":"select","id":"mission_icon","label":"Icon","options":[{"value":"target","label":"Target"},{"value":"eye","label":"Eye"},{"value":"heart","label":"Heart"},{"value":"star","label":"Star"},{"value":"compass","label":"Compass"}],"default":"target"},{"type":"text","id":"mission_label","label":"Label","default":"Unsere Mission"},{"type":"text","id":"mission_heading","label":"Heading","default":"Was uns antreibt"},{"type":"richtext","id":"mission_text","label":"Text","default":"<p>Wir entwickeln Lösungen, die Menschen im Alltag zuverlässig unterstützen.</p><p>Dabei verbinden wir Qualität, Innovation und Verantwortung.</p>"},{"type":"header","content":"Vision"},{"type":"select","id":"vision_icon","label":"Icon","options":[{"value":"target","label":"Target"},{"value":"eye","label":"Eye"},{"value":"heart","label":"Heart"},{"value":"star","label":"Star"},{"value":"compass","label":"Compass"}],"default":"eye"},{"type":"text","id":"vision_label","label":"Label","default":"Unsere Vision"},{"type":"text","id":"vision_heading","label":"Heading","default":"Wohin wir wollen"},{"type":"richtext","id":"vision_text","label":"Text","default":"<p>Wir gestalten eine Zukunft, in der Vertrauen und Fortschritt zusammengehören.</p><p>Unser Ziel ist eine bessere Versorgung für alle.</p>"},{"type":"header","content":"Typography"},{"type":"color","id":"icon_color","label":"Icon color","default":"#1d2e40"},{"type":"range","id":"icon_size","label":"Icon size desktop","min":20,"max":100,"step":5,"unit":"px","default":50},{"type":"range","id":"icon_size_mobile","label":"Icon size mobile","min":20,"max":80,"step":5,"unit":"px","default":40},{"type":"color","id":"label_color","label":"Label color","default":"#126fd3"},{"type":"range","id":"label_size","label":"Label size","min":10,"max":24,"step":1,"unit":"px","default":13},{"type":"color","id":"heading_color","label":"Heading color","default":"#1d2e40"},{"type":"range","id":"heading_size","label":"Heading size desktop","min":24,"max":72,"step":2,"unit":"px","default":44},{"type":"range","id":"heading_size_mobile","label":"Heading size mobile","min":22,"max":52,"step":2,"unit":"px","default":32},{"type":"color","id":"body_color","label":"Body text color","default":"#334155"},{"type":"range","id":"body_size","label":"Body size desktop","min":14,"max":24,"step":1,"unit":"px","default":17},{"type":"range","id":"body_size_mobile","label":"Body size mobile","min":14,"max":22,"step":1,"unit":"px","default":16},{"type":"range","id":"body_line_height","label":"Line height","min":1.2,"max":2.2,"step":0.1,"default":1.7},{"type":"header","content":"Divider"},{"type":"color","id":"divider_color","label":"Color","default":"#cbd5e1"},{"type":"range","id":"divider_width","label":"Strength","min":1,"max":4,"step":1,"unit":"px","default":1}],"presets":[{"name":"Mission & Vision"}],"tag":null,"class":"mission-vision-block"}{% endschema %}