{% doc %}
  @prompt
    Erstelle auf der Produktdetailseite unterhalb der Produktinformationen eine moderne Tab-Section mit zwei Tabs: „Beschreibung“ und „Informationen“. Die Section soll als weiße Card mit abgerundeten Ecken, dezenter grauer Umrandung und leichtem Schatten gestaltet sein. Der aktive Tab soll in Blau hervorgehoben und mit einer blauen Linie unterstrichen werden. Im Tab „Beschreibung“ soll zunächst ein kurzer Produkttext erscheinen, darunter bis zu drei kompakte Produktvorteile mit runden Check-Icons. Der Tab „Informationen“ soll für zusätzliche technische Daten und Produktinformationen vorgesehen sein. Verwende ein sauberes, modernes Layout mit Manrope als Schriftart und ausreichend Innenabstand.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-tabs-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 28px auto;
    color: #1d2e40;
    font-family: 'Manrope', sans-serif;
  }

  .ai-product-tabs-{{ ai_gen_id }}__card {
    overflow: hidden;
    padding: 28px;
    background: #ffffff;
    border: 1px solid #dce2e8;
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(29, 46, 64, 0.08);
  }

  .ai-product-tabs-{{ ai_gen_id }}__nav {
    display: flex;
    gap: 28px;
    border-bottom: 1px solid #e4e8ed;
  }

  .ai-product-tabs-{{ ai_gen_id }}__tab {
    position: relative;
    padding: 0 0 14px;
    border: 0;
    background: transparent;
    color: #526171;
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }

  .ai-product-tabs-{{ ai_gen_id }}__tab[aria-selected="true"] {
    color: #126fd3;
  }

  .ai-product-tabs-{{ ai_gen_id }}__tab[aria-selected="true"]::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: #126fd3;
    content: '';
  }

  .ai-product-tabs-{{ ai_gen_id }}__tab:focus-visible {
    outline: 2px solid #126fd3;
    outline-offset: 4px;
  }

  .ai-product-tabs-{{ ai_gen_id }}__panel {
    padding-top: 22px;
    line-height: 1.7;
    font-size: 14px;
  }

  .ai-product-tabs-{{ ai_gen_id }}__panel[hidden] {
    display: none;
  }

  .ai-product-tabs-{{ ai_gen_id }}__intro > :first-child {
    margin-top: 0;
  }

  .ai-product-tabs-{{ ai_gen_id }}__intro > :last-child {
    margin-bottom: 0;
  }

  .ai-product-tabs-{{ ai_gen_id }}__benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .ai-product-tabs-{{ ai_gen_id }}__benefit {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 13px;
    border: 1px solid #e7ebef;
    border-radius: 8px;
    background: #f9fbfc;
    line-height: 1.5;
  }

  .ai-product-tabs-{{ ai_gen_id }}__check {
    display: inline-flex;
    flex: 0 0 20px;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    background: #e8f2fc;
    color: #126fd3;
  }

  .ai-product-tabs-{{ ai_gen_id }}__check svg {
    width: 12px;
    height: 12px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-tabs-{{ ai_gen_id }}__card {
      padding: 20px;
    }

    .ai-product-tabs-{{ ai_gen_id }}__benefits {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
{% endstyle %}

<product-info-tabs-{{ ai_gen_id }} class="ai-product-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-tabs-{{ ai_gen_id }}__card">
    <div class="ai-product-tabs-{{ ai_gen_id }}__nav" role="tablist" aria-label="Produktdetails">
      <button class="ai-product-tabs-{{ ai_gen_id }}__tab" id="ai-tab-description-{{ ai_gen_id }}" type="button" role="tab" aria-selected="true" aria-controls="ai-panel-description-{{ ai_gen_id }}" tabindex="0">Beschreibung</button>
      <button class="ai-product-tabs-{{ ai_gen_id }}__tab" id="ai-tab-information-{{ ai_gen_id }}" type="button" role="tab" aria-selected="false" aria-controls="ai-panel-information-{{ ai_gen_id }}" tabindex="-1">Informationen</button>
    </div>
    <div class="ai-product-tabs-{{ ai_gen_id }}__panel" id="ai-panel-description-{{ ai_gen_id }}" role="tabpanel" aria-labelledby="ai-tab-description-{{ ai_gen_id }}" tabindex="0">
      <div class="ai-product-tabs-{{ ai_gen_id }}__intro">{% if block.settings.description_text != blank %}{{ block.settings.description_text }}{% elsif product.description != blank %}{{ product.description }}{% else %}<p>Fügen Sie eine kurze Produktbeschreibung hinzu.</p>{% endif %}</div>
      {% assign benefit_list = '' | split: ',' %}
      {% if block.settings.benefit_one != blank %}{% assign benefit_list = benefit_list | push: block.settings.benefit_one %}{% endif %}
      {% if block.settings.benefit_two != blank %}{% assign benefit_list = benefit_list | push: block.settings.benefit_two %}{% endif %}
      {% if block.settings.benefit_three != blank %}{% assign benefit_list = benefit_list | push: block.settings.benefit_three %}{% endif %}
      {% if benefit_list.size > 0 %}
        <ul class="ai-product-tabs-{{ ai_gen_id }}__benefits">
          {% for benefit in benefit_list %}
            <li class="ai-product-tabs-{{ ai_gen_id }}__benefit"><span class="ai-product-tabs-{{ ai_gen_id }}__check" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="m3.5 8 3 3 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>{{ benefit | escape }}</span></li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
    <div class="ai-product-tabs-{{ ai_gen_id }}__panel" id="ai-panel-information-{{ ai_gen_id }}" role="tabpanel" aria-labelledby="ai-tab-information-{{ ai_gen_id }}" tabindex="0" hidden>
      {% if block.settings.information_text != blank %}{{ block.settings.information_text }}{% else %}<p>Ergänzen Sie hier technische Daten, Lieferumfang und weitere Produktinformationen.</p>{% endif %}
    </div>
  </div>
</product-info-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'product-info-tabs-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ProductInfoTabs extends HTMLElement {
      connectedCallback() {
        this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
        this.panels = Array.from(this.querySelectorAll('[role="tabpanel"]'));
        this.tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => this.activate(index));
          tab.addEventListener('keydown', (event) => {
            let nextIndex = index;
            if (event.key === 'ArrowRight') nextIndex = (index + 1) % this.tabs.length;
            else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + this.tabs.length) % this.tabs.length;
            else if (event.key === 'Home') nextIndex = 0;
            else if (event.key === 'End') nextIndex = this.tabs.length - 1;
            else return;
            event.preventDefault();
            this.activate(nextIndex);
            this.tabs[nextIndex].focus();
          });
        });
      }
      activate(activeIndex) {
        this.tabs.forEach((tab, index) => {
          const active = index === activeIndex;
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.tabIndex = active ? 0 : -1;
          this.panels[index].hidden = !active;
        });
      }
    }
    customElements.define(tagName, ProductInfoTabs);
  })();
</script>

{% schema %}
{
  "name": "Produktdetail-Tabs",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Beschreibung"
    },
    {
      "type": "richtext",
      "id": "description_text",
      "label": "Produkttext",
      "default": "<p>Eine kurze, informative Beschreibung des Produkts.</p>"
    },
    {
      "type": "text",
      "id": "benefit_one",
      "label": "Vorteil 1",
      "default": "Zuverlässige Qualität"
    },
    {
      "type": "text",
      "id": "benefit_two",
      "label": "Vorteil 2",
      "default": "Für den professionellen Einsatz"
    },
    {
      "type": "text",
      "id": "benefit_three",
      "label": "Vorteil 3",
      "default": "Sorgfältig ausgewählte Materialien"
    },
    {
      "type": "header",
      "content": "Informationen"
    },
    {
      "type": "richtext",
      "id": "information_text",
      "label": "Technische Daten und weitere Angaben",
      "default": "<p>Hier können technische Daten, Produktdetails und ergänzende Informationen stehen.</p>"
    }
  ],
  "presets": [
    {
      "name": "Produktdetail-Tabs"
    }
  ],
  "tag": null,
  "class": "product-detail-tabs"
}
{% endschema %}