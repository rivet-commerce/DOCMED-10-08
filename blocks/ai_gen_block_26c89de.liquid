{% doc %}
  @prompt
    Erstelle eine vollständig responsive Text-und-Icon-Section im gleichen einheitlichen Content-Raster wie die anderen Sections.
    
    Desktop: Zweispaltiges Layout. Links steht der Textbereich mit kleiner Eyebrow-Überschrift in Großbuchstaben, großer Hauptüberschrift und mehreren Fließtext-Absätzen. Rechts befindet sich eine weiße, leicht abgerundete Fläche mit einem 2 × 3 Icon-Raster für bis zu 6 Elemente.
    
    Jedes Icon-Element besteht aus einem frei auswählbaren/hochladbaren Icon und einer frei bearbeitbaren Bezeichnung darunter. Icon-Größe, Textgröße, Icon-Farbe bzw. Darstellung und Abstände müssen einstellbar sein.
    
    Das Icon-Raster darf keine einzelnen Karten oder vollständigen Rahmen haben. Die sechs Bereiche werden ausschließlich durch sehr feine, dezente Trennlinien voneinander getrennt: eine vertikale Linie zwischen den beiden Spalten und horizontale Linien zwischen den drei Reihen. Keine äußere Umrandung des Rasters. Die Trennlinien sollen vor den Außenkanten enden und nicht wie ein geschlossenes Tabellenraster wirken. Farbe und Stärke der Trennlinien müssen einstellbar sein.
    
    Im Shopify-Editor müssen außerdem Section-Breite/-Höhe, Seitenabstand Desktop/Mobile, Padding oben/unten, Spaltenverhältnis, Spaltenabstand, Hintergrundfarbe, Farbe der Icon-Fläche, Rundung, Eyebrow-Größe, Überschriftgröße Desktop/Mobile, Fließtextgröße Desktop/Mobile sowie alle Textfarben einstellbar sein.
    
    Mobile: Textbereich oben, Icon-Raster darunter. Das Raster bleibt 2-spaltig, die Elemente skalieren responsiv. Textbereich und Icon-Bereich müssen exakt dieselbe Content-Breite und dieselben Seitenabstände verwenden. Die gesamte Section muss auf allen Bildschirmgrößen sauber responsiv sein und sich exakt an der Breite der anderen Sections ausrichten.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-feature-section-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};padding:{{ block.settings.padding_top }}px {{ block.settings.desktop_side_padding }}px {{ block.settings.padding_bottom }}px}.ai-feature-section-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:100%;min-height:{{ block.settings.section_height }}px;margin:0 auto;display:grid;grid-template-columns:{{ block.settings.text_column_width }}% 1fr;gap:{{ block.settings.column_gap }}px;align-items:center}.ai-feature-section-{{ ai_gen_id }}__text{color:{{ block.settings.text_color }}}.ai-feature-section-{{ ai_gen_id }}__eyebrow{margin:0 0 14px;color:{{ block.settings.eyebrow_color }};font-size:{{ block.settings.eyebrow_size }}px;line-height:1.3;letter-spacing:.14em;text-transform:uppercase;font-weight:700}.ai-feature-section-{{ ai_gen_id }}__heading{margin:0 0 20px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size_desktop }}px;line-height:1.1;font-family:{{ block.settings.heading_font.family }};font-weight:600}.ai-feature-section-{{ ai_gen_id }}__copy{color:{{ block.settings.copy_color }};font-size:{{ block.settings.copy_size_desktop }}px;line-height:1.65}.ai-feature-section-{{ ai_gen_id }}__copy p{margin:0 0 14px}.ai-feature-section-{{ ai_gen_id }}__copy p:last-child{margin-bottom:0}.ai-feature-section-{{ ai_gen_id }}__features{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));background:{{ block.settings.icon_area_color }};border-radius:{{ block.settings.icon_area_radius }}px;padding:{{ block.settings.icon_area_padding }}px}.ai-feature-section-{{ ai_gen_id }}__item{position:relative;display:flex;min-width:0;min-height:130px;padding:{{ block.settings.item_spacing }}px;flex-direction:column;align-items:center;justify-content:center;text-align:center}.ai-feature-section-{{ ai_gen_id }}__item:nth-child(odd)::after{content:'';position:absolute;top:18%;bottom:18%;right:0;width:{{ block.settings.divider_thickness }}px;background:{{ block.settings.divider_color }}}.ai-feature-section-{{ ai_gen_id }}__item:nth-child(n+3)::before{content:'';position:absolute;top:0;left:12%;right:12%;height:{{ block.settings.divider_thickness }}px;background:{{ block.settings.divider_color }}}.ai-feature-section-{{ ai_gen_id }}__icon,.ai-feature-section-{{ ai_gen_id }}__placeholder{width:{{ block.settings.icon_size }}px;height:{{ block.settings.icon_size }}px;margin-bottom:14px;object-fit:contain;flex:0 0 auto}.ai-feature-section-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;fill:{{ block.settings.icon_color }};color:{{ block.settings.icon_color }}}.ai-feature-section-{{ ai_gen_id }}__icon{filter:{{ block.settings.icon_treatment }}}.ai-feature-section-{{ ai_gen_id }}__label{color:{{ block.settings.label_color }};font-size:{{ block.settings.label_size }}px;line-height:1.35;font-weight:600}@media screen and (max-width:749px){.ai-feature-section-{{ ai_gen_id }}{padding-left:{{ block.settings.mobile_side_padding }}px;padding-right:{{ block.settings.mobile_side_padding }}px}.ai-feature-section-{{ ai_gen_id }}__inner{width:100%;min-height:auto;grid-template-columns:1fr;gap:{{ block.settings.mobile_content_gap }}px}.ai-feature-section-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size_mobile }}px}.ai-feature-section-{{ ai_gen_id }}__copy{font-size:{{ block.settings.copy_size_mobile }}px}.ai-feature-section-{{ ai_gen_id }}__item{min-height:112px;padding:{{ block.settings.mobile_item_spacing }}px}.ai-feature-section-{{ ai_gen_id }}__icon,.ai-feature-section-{{ ai_gen_id }}__placeholder{width:min({{ block.settings.icon_size }}px,18vw);height:min({{ block.settings.icon_size }}px,18vw)}}
{% endstyle %}
<section class="ai-feature-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-feature-section-{{ ai_gen_id }}__inner"><div class="ai-feature-section-{{ ai_gen_id }}__text">{% if block.settings.eyebrow != blank %}<p class="ai-feature-section-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-feature-section-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}<div class="ai-feature-section-{{ ai_gen_id }}__copy">{{ block.settings.copy }}</div></div><div class="ai-feature-section-{{ ai_gen_id }}__features">{% for i in (1..6) %}{% assign image_key='icon_' | append:i %}{% assign label_key='label_' | append:i %}<div class="ai-feature-section-{{ ai_gen_id }}__item">{% if block.settings[image_key] %}<img class="ai-feature-section-{{ ai_gen_id }}__icon" src="{{ block.settings[image_key] | image_url: width: 300 }}" alt="" loading="lazy">{% else %}<div class="ai-feature-section-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-feature-section-{{ ai_gen_id }}__label">{{ block.settings[label_key] }}</div></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Text and icon grid","tag":null,"class":"text-icon-grid-block","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Unsere Vorteile"},{"type":"text","id":"heading","label":"Heading","default":"Verlässlich ausgestattet"},{"type":"richtext","id":"copy","label":"Text","default":"<p>Entdecken Sie zuverlässige Lösungen für Praxis, Labor und Ausbildung.</p><p>Wir unterstützen Sie mit ausgewählten Produkten und persönlicher Beratung.</p>"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Section width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_height","label":"Section height","min":240,"max":900,"step":20,"unit":"px","default":480},{"type":"range","id":"desktop_side_padding","label":"Desktop side spacing","min":0,"max":120,"step":5,"unit":"px","default":20},{"type":"range","id":"mobile_side_padding","label":"Mobile side spacing","min":0,"max":40,"step":2,"unit":"px","default":16},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":10,"unit":"px","default":60},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":10,"unit":"px","default":60},{"type":"range","id":"text_column_width","label":"Text column","min":30,"max":60,"step":5,"unit":"%","default":45},{"type":"range","id":"column_gap","label":"Column gap","min":10,"max":120,"step":5,"unit":"px","default":60},{"type":"range","id":"mobile_content_gap","label":"Mobile content gap","min":10,"max":80,"step":5,"unit":"px","default":35},{"type":"header","content":"Icons"},{"type":"color","id":"icon_area_color","label":"Icon area","default":"#ffffff"},{"type":"range","id":"icon_area_radius","label":"Area radius","min":0,"max":30,"step":2,"unit":"px","default":8},{"type":"range","id":"icon_area_padding","label":"Area padding","min":0,"max":50,"step":5,"unit":"px","default":20},{"type":"range","id":"icon_size","label":"Icon size","min":24,"max":100,"step":4,"unit":"px","default":48},{"type":"color","id":"icon_color","label":"Icon color","default":"#1d2e40"},{"type":"select","id":"icon_treatment","label":"Icon display","options":[{"value":"none","label":"Original"},{"value":"grayscale(1)","label":"Grayscale"}],"default":"none"},{"type":"range","id":"item_spacing","label":"Item spacing","min":4,"max":40,"step":4,"unit":"px","default":12},{"type":"range","id":"mobile_item_spacing","label":"Mobile item spacing","min":4,"max":30,"step":2,"unit":"px","default":10},{"type":"color","id":"divider_color","label":"Divider color","default":"#d9e0e5"},{"type":"range","id":"divider_thickness","label":"Divider thickness","min":1,"max":3,"step":1,"unit":"px","default":1},{"type":"header","content":"Typography and colors"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"poppins_n4"},{"type":"range","id":"eyebrow_size","label":"Eyebrow size","min":10,"max":20,"step":1,"unit":"px","default":12},{"type":"range","id":"heading_size_desktop","label":"Heading desktop","min":24,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"heading_size_mobile","label":"Heading mobile","min":22,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"copy_size_desktop","label":"Text desktop","min":14,"max":24,"step":1,"unit":"px","default":17},{"type":"range","id":"copy_size_mobile","label":"Text mobile","min":14,"max":22,"step":1,"unit":"px","default":16},{"type":"range","id":"label_size","label":"Label size","min":12,"max":22,"step":1,"unit":"px","default":15},{"type":"color","id":"background_color","label":"Background","default":"#f5f8fa"},{"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#1d2e40"},{"type":"color","id":"heading_color","label":"Heading","default":"#1d2e40"},{"type":"color","id":"text_color","label":"Text area","default":"#1d2e40"},{"type":"color","id":"copy_color","label":"Paragraphs","default":"#405466"},{"type":"color","id":"label_color","label":"Icon labels","default":"#1d2e40"},{"type":"header","content":"Icon 1"},{"type":"image_picker","id":"icon_1","label":"Icon"},{"type":"text","id":"label_1","label":"Label","default":"Zuverlässige Qualität"},{"type":"header","content":"Icon 2"},{"type":"image_picker","id":"icon_2","label":"Icon"},{"type":"text","id":"label_2","label":"Label","default":"Schnelle Lieferung"},{"type":"header","content":"Icon 3"},{"type":"image_picker","id":"icon_3","label":"Icon"},{"type":"text","id":"label_3","label":"Label","default":"Persönliche Beratung"},{"type":"header","content":"Icon 4"},{"type":"image_picker","id":"icon_4","label":"Icon"},{"type":"text","id":"label_4","label":"Label","default":"Geprüfte Produkte"},{"type":"header","content":"Icon 5"},{"type":"image_picker","id":"icon_5","label":"Icon"},{"type":"text","id":"label_5","label":"Label","default":"Für Profis entwickelt"},{"type":"header","content":"Icon 6"},{"type":"image_picker","id":"icon_6","label":"Icon"},{"type":"text","id":"label_6","label":"Label","default":"Kompetenter Service"}],"presets":[{"name":"Text and icon grid"}]}{% endschema %}