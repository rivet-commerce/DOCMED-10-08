{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-global-reach-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.body_color }};}.ai-global-reach-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1500px;margin:0 auto;padding:{{ block.settings.section_padding }}px 0}.ai-global-reach-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:minmax(0,35fr) minmax(0,65fr);gap:{{ block.settings.column_gap }}px;align-items:center}.ai-global-reach-{{ ai_gen_id }}__content{min-width:0}.ai-global-reach-{{ ai_gen_id }}__eyebrow{margin:0 0 16px;color:{{ block.settings.accent_color }};font-size:12px;font-weight:700;letter-spacing:.12em;line-height:1.4}.ai-global-reach-{{ ai_gen_id }}__heading{margin:0 0 18px;color:{{ block.settings.heading_color }};font-size:clamp(30px,3.1vw,52px);font-weight:700;line-height:1.08}.ai-global-reach-{{ ai_gen_id }}__text{max-width:520px;margin:0;font-size:16px;line-height:1.65}.ai-global-reach-{{ ai_gen_id }}__stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:38px}.ai-global-reach-{{ ai_gen_id }}__stat{min-width:0;padding:0 14px}.ai-global-reach-{{ ai_gen_id }}__stat:first-child{padding-left:0}.ai-global-reach-{{ ai_gen_id }}__stat+.ai-global-reach-{{ ai_gen_id }}__stat{border-left:1px solid {{ block.settings.separator_color }}}.ai-global-reach-{{ ai_gen_id }}__number{display:block;color:{{ block.settings.accent_color }};font-size:clamp(22px,2.2vw,36px);font-weight:700;line-height:1;white-space:nowrap}.ai-global-reach-{{ ai_gen_id }}__label{display:block;margin-top:9px;font-size:13px;line-height:1.35}.ai-global-reach-{{ ai_gen_id }}__media{width:100%;min-width:0;overflow:hidden;border-radius:{{ block.settings.image_radius }}px;background:{{ block.settings.image_background }}}.ai-global-reach-{{ ai_gen_id }}__image,.ai-global-reach-{{ ai_gen_id }}__placeholder{display:block;width:100%;height:{{ block.settings.image_height }}px}.ai-global-reach-{{ ai_gen_id }}__image{object-fit:{{ block.settings.image_fit }}}.ai-global-reach-{{ ai_gen_id }}__placeholder{position:relative;display:flex;align-items:center;justify-content:center;color:#657789}.ai-global-reach-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-global-reach-{{ ai_gen_id }}__empty-state{position:absolute;bottom:18px;left:50%;width:calc(100% - 36px);transform:translateX(-50%);padding:8px 12px;color:#526575;background:rgba(255,255,255,.9);font-size:13px;text-align:center}
@media(max-width:989px){.ai-global-reach-{{ ai_gen_id }}__inner{padding:{{ block.settings.tablet_padding }}px 0}.ai-global-reach-{{ ai_gen_id }}__grid{grid-template-columns:minmax(0,40fr) minmax(0,60fr);gap:{{ block.settings.tablet_gap }}px}.ai-global-reach-{{ ai_gen_id }}__heading{font-size:34px}.ai-global-reach-{{ ai_gen_id }}__text{font-size:15px}.ai-global-reach-{{ ai_gen_id }}__stats{margin-top:28px}.ai-global-reach-{{ ai_gen_id }}__stat{padding:0 8px}.ai-global-reach-{{ ai_gen_id }}__number{font-size:24px}.ai-global-reach-{{ ai_gen_id }}__image,.ai-global-reach-{{ ai_gen_id }}__placeholder{height:{{ block.settings.tablet_image_height }}px}}@media(max-width:749px){.ai-global-reach-{{ ai_gen_id }}__inner{width:100%;padding:{{ block.settings.mobile_padding }}px 20px}.ai-global-reach-{{ ai_gen_id }}__grid{grid-template-columns:1fr;gap:30px}.ai-global-reach-{{ ai_gen_id }}__heading{font-size:32px}.ai-global-reach-{{ ai_gen_id }}__stats{margin-top:30px}.ai-global-reach-{{ ai_gen_id }}__stat{padding:0 6px}.ai-global-reach-{{ ai_gen_id }}__number{font-size:22px}.ai-global-reach-{{ ai_gen_id }}__label{font-size:12px}.ai-global-reach-{{ ai_gen_id }}__image,.ai-global-reach-{{ ai_gen_id }}__placeholder{height:{{ block.settings.mobile_image_height }}px}}@media(max-width:390px){.ai-global-reach-{{ ai_gen_id }}__stats{grid-template-columns:1fr 1fr;row-gap:20px}.ai-global-reach-{{ ai_gen_id }}__stat:nth-child(3){grid-column:1/-1;padding-left:0;border-left:0;border-top:1px solid {{ block.settings.separator_color }};padding-top:18px}}
{% endstyle %}
<global-reach-{{ ai_gen_id }} class="ai-global-reach-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-global-reach-{{ ai_gen_id }}__inner"><div class="ai-global-reach-{{ ai_gen_id }}__grid"><div class="ai-global-reach-{{ ai_gen_id }}__content"><p class="ai-global-reach-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h2 class="ai-global-reach-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2><p class="ai-global-reach-{{ ai_gen_id }}__text">{{ block.settings.body }}</p><div class="ai-global-reach-{{ ai_gen_id }}__stats"><div class="ai-global-reach-{{ ai_gen_id }}__stat"><span class="ai-global-reach-{{ ai_gen_id }}__number">{{ block.settings.stat_one_number }}</span><span class="ai-global-reach-{{ ai_gen_id }}__label">{{ block.settings.stat_one_label }}</span></div><div class="ai-global-reach-{{ ai_gen_id }}__stat"><span class="ai-global-reach-{{ ai_gen_id }}__number">{{ block.settings.stat_two_number }}</span><span class="ai-global-reach-{{ ai_gen_id }}__label">{{ block.settings.stat_two_label }}</span></div><div class="ai-global-reach-{{ ai_gen_id }}__stat"><span class="ai-global-reach-{{ ai_gen_id }}__number">{{ block.settings.stat_three_number }}</span><span class="ai-global-reach-{{ ai_gen_id }}__label">{{ block.settings.stat_three_label }}</span></div></div></div><div class="ai-global-reach-{{ ai_gen_id }}__media">{% if block.settings.image != blank %}<img class="ai-global-reach-{{ ai_gen_id }}__image" src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-global-reach-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-global-reach-{{ ai_gen_id }}__empty-state">Füge ein Bild für die internationale Präsenz hinzu</span></div>{% endif %}</div></div></div></global-reach-{{ ai_gen_id }}>
<script>(function(){if(!customElements.get('global-reach-{{ ai_gen_id }}'))customElements.define('global-reach-{{ ai_gen_id }}',class extends HTMLElement{});})();</script>
