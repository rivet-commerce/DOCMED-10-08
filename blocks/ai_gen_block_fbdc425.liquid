{% doc %}
  @prompt
    Erstelle eine vollständig responsive Text-Bild-Section im gleichen einheitlichen Seitenraster wie die anderen Sections.
    
    Desktop: Links befindet sich ein großes rechteckiges Bild mit leicht abgerundeten Ecken. Rechts steht der Textbereich mit einer großen, fetten Überschrift und darunter zwei getrennten Fließtext-Absätzen. Bild und Text sind ungefähr 50/50 aufgeteilt und vertikal mittig ausgerichtet.
    
    Im Shopify-Editor müssen Section-Breite, Section-Höhe, Seitenabstand Desktop/Mobile, Padding oben/unten, Spaltenverhältnis, Spaltenabstand, Bildbreite/-höhe, Überschriftgröße Desktop/Mobile, Textgröße Desktop/Mobile sowie Hintergrund-, Überschrift- und Textfarbe frei einstellbar sein.
    
    Mobile: Text oben, Bild darunter. Beide Elemente müssen exakt dieselbe Content-Breite und dieselben Seitenabstände verwenden. Die gesamte Section muss auf allen Bildschirmgrößen responsiv skalieren und sich exakt an der Breite der anderen Sections ausrichten.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-text-image-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};padding:{{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;box-sizing:border-box}.ai-text-image__inner-{{ ai_gen_id }}{width:100%;max-width:{{ block.settings.content_width }}px;min-height:{{ block.settings.section_height }}px;margin:0 auto;padding:0 {{ block.settings.desktop_side_padding }}px;box-sizing:border-box;display:grid;grid-template-columns:{{ block.settings.image_column_percent }}% calc(100% - {{ block.settings.image_column_percent }}%);gap:{{ block.settings.column_gap }}px;align-items:center}.ai-text-image__media-{{ ai_gen_id }}{width:100%;height:{{ block.settings.image_height }}px;overflow:hidden;border-radius:{{ block.settings.image_radius }}px}.ai-text-image__media-{{ ai_gen_id }} img{display:block;width:100%;height:100%;object-fit:cover}.ai-text-image__placeholder-{{ ai_gen_id }}{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#eef2f4;color:#53616b}.ai-text-image__placeholder-{{ ai_gen_id }} svg{width:100%;height:100%;max-width:420px;max-height:420px}.ai-text-image__content-{{ ai_gen_id }}{width:100%;color:{{ block.settings.text_color }};display:flex;flex-direction:column;justify-content:center}.ai-text-image__heading-{{ ai_gen_id }}{margin:0 0 22px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size_desktop }}px;line-height:1.1;font-weight:700}.ai-text-image__paragraph-{{ ai_gen_id }}{margin:0 0 16px;font-size:{{ block.settings.text_size_desktop }}px;line-height:1.6}.ai-text-image__paragraph-{{ ai_gen_id }}:last-child{margin-bottom:0}@media screen and (max-width:749px){.ai-text-image-{{ ai_gen_id }}{padding-top:{{ block.settings.mobile_padding_top }}px;padding-bottom:{{ block.settings.mobile_padding_bottom }}px}.ai-text-image__inner-{{ ai_gen_id }}{min-height:0;padding-left:{{ block.settings.mobile_side_padding }}px;padding-right:{{ block.settings.mobile_side_padding }}px;display:flex;flex-direction:column;gap:{{ block.settings.column_gap }}px;align-items:stretch}.ai-text-image__content-{{ ai_gen_id }}{order:1}.ai-text-image__media-{{ ai_gen_id }}{order:2;height:{{ block.settings.mobile_image_height }}px}.ai-text-image__heading-{{ ai_gen_id }}{font-size:{{ block.settings.heading_size_mobile }}px}.ai-text-image__paragraph-{{ ai_gen_id }}{font-size:{{ block.settings.text_size_mobile }}px}}
{% endstyle %}
<div class="ai-text-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-text-image__inner-{{ ai_gen_id }}"><div class="ai-text-image__media-{{ ai_gen_id }}">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-text-image__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-text-image__content-{{ ai_gen_id }}">{% if block.settings.heading != blank %}<h2 class="ai-text-image__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.paragraph_one != blank %}<div class="ai-text-image__paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph_one }}</div>{% endif %}{% if block.settings.paragraph_two != blank %}<div class="ai-text-image__paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph_two }}</div>{% endif %}</div></div></div>
{% schema %}{"name":"Text image section","settings":[{"type":"header","content":"Content"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Reliable solutions for your practice"},{"type":"richtext","id":"paragraph_one","label":"First paragraph","default":"<p>Discover professional products and dependable support for your daily work.</p>"},{"type":"richtext","id":"paragraph_two","label":"Second paragraph","default":"<p>We combine practical expertise with carefully selected quality to help you work with confidence.</p>"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Section width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"content_width","label":"Content width","min":1000,"max":1800,"step":50,"unit":"px","default":1500},{"type":"range","id":"section_height","label":"Section height","min":300,"max":900,"step":25,"unit":"px","default":550},{"type":"select","id":"image_column_percent","label":"Image column","options":[{"value":"40","label":"40%"},{"value":"45","label":"45%"},{"value":"50","label":"50%"},{"value":"55","label":"55%"},{"value":"60","label":"60%"}],"default":"50"},{"type":"range","id":"column_gap","label":"Column gap","min":0,"max":120,"step":5,"unit":"px","default":60},{"type":"range","id":"desktop_side_padding","label":"Desktop side padding","min":0,"max":100,"step":5,"unit":"px","default":20},{"type":"range","id":"mobile_side_padding","label":"Mobile side padding","min":0,"max":50,"step":5,"unit":"px","default":20},{"type":"range","id":"padding_top","label":"Padding top","min":0,"max":160,"step":10,"unit":"px","default":60},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":160,"step":10,"unit":"px","default":60},{"type":"range","id":"mobile_padding_top","label":"Mobile padding top","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"mobile_padding_bottom","label":"Mobile padding bottom","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"image_height","label":"Image height","min":250,"max":800,"step":25,"unit":"px","default":500},{"type":"range","id":"mobile_image_height","label":"Mobile image height","min":180,"max":600,"step":20,"unit":"px","default":320},{"type":"range","id":"image_radius","label":"Image radius","min":0,"max":30,"step":2,"unit":"px","default":8},{"type":"header","content":"Typography and colors"},{"type":"range","id":"heading_size_desktop","label":"Heading size desktop","min":24,"max":72,"step":2,"unit":"px","default":48},{"type":"range","id":"heading_size_mobile","label":"Heading size mobile","min":22,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"text_size_desktop","label":"Text size desktop","min":14,"max":26,"step":1,"unit":"px","default":17},{"type":"range","id":"text_size_mobile","label":"Text size mobile","min":14,"max":24,"step":1,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Heading","default":"#1d2e40"},{"type":"color","id":"text_color","label":"Text","default":"#1d2e40"}],"presets":[{"name":"Text image section"}],"tag":null,"class":"text-image-section"}{% endschema %}