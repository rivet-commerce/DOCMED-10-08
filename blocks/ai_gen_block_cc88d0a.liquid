{% doc %}
  @prompt
    Erstelle eine responsive „Über DocMed“-Section mit einem zweispaltigen Layout und viel Weißraum.
    
    Desktop: Links befindet sich der Textbereich, rechts ein großes Bild. Der Textbereich enthält oben eine kleine Eyebrow/Unterzeile in Großbuchstaben, darunter eine sehr große Hauptüberschrift, anschließend einen Fließtext und darunter einen fett hervorgehobenen Abschlusssatz. Das Bild ist groß, rechteckig und leicht abgerundet. Text und Bild sind vertikal mittig zueinander ausgerichtet.
    
    Die Section muss sich an ein einheitliches Content-Raster halten, damit sie exakt dieselbe Breite und Ausrichtung wie alle anderen Sections der Seite hat.
    
    Im Shopify-Editor müssen einstellbar sein: Section-Breite, Section-Höhe, Seitenabstand Desktop, Seitenabstand Mobile, Abstand oben/unten, Spaltenverhältnis, Abstand zwischen den Spalten, Bildbreite/-höhe, Eyebrow-Schriftgröße, Überschriftgröße Desktop/Mobile, Fließtextgröße Desktop/Mobile sowie alle Text- und Hintergrundfarben.
    
    Mobile: Alles untereinander: Text oben, Bild darunter. Text und Bild müssen exakt dieselbe Breite und denselben Seitenabstand verwenden. Alle Größen und Abstände müssen responsiv sein und dürfen auf keiner Bildschirmgröße überlaufen.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-about-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:{{ block.settings.space_top }}px auto {{ block.settings.space_bottom }}px;padding:0 {{ block.settings.desktop_side_padding }}px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};box-sizing:border-box}.ai-about-{{ ai_gen_id }}__inner{width:100%;max-width:{{ block.settings.content_max_width }}px;min-height:{{ block.settings.section_height }}px;margin:0 auto;display:grid;grid-template-columns:minmax(0,{{ block.settings.text_column_percent }}fr) minmax(0,{{ 100 | minus: block.settings.text_column_percent }}fr);align-items:center;gap:{{ block.settings.column_gap }}px}.ai-about-{{ ai_gen_id }}__content{min-width:0}.ai-about-{{ ai_gen_id }}__eyebrow{margin:0 0 18px;color:{{ block.settings.eyebrow_color }};font-size:{{ block.settings.eyebrow_size }}px;font-weight:700;letter-spacing:.14em;line-height:1.3;text-transform:uppercase}.ai-about-{{ ai_gen_id }}__heading{margin:0 0 24px;color:{{ block.settings.heading_color }};font-family:var(--font-heading-family,sans-serif);font-size:{{ block.settings.heading_size_desktop }}px;font-weight:600;line-height:1.04;overflow-wrap:anywhere}.ai-about-{{ ai_gen_id }}__body{margin:0 0 24px;color:{{ block.settings.body_color }};font-size:{{ block.settings.body_size_desktop }}px;line-height:1.65;overflow-wrap:anywhere}.ai-about-{{ ai_gen_id }}__closing{margin:0;color:{{ block.settings.closing_color }};font-size:{{ block.settings.body_size_desktop }}px;font-weight:700;line-height:1.5;overflow-wrap:anywhere}.ai-about-{{ ai_gen_id }}__media{width:100%;max-width:{{ block.settings.image_width }}px;height:{{ block.settings.image_height }}px;justify-self:end;overflow:hidden;border-radius:{{ block.settings.image_radius }}px;background:{{ block.settings.image_placeholder_color }};}.ai-about-{{ ai_gen_id }}__media img,.ai-about-{{ ai_gen_id }}__media-placeholder svg{display:block;width:100%;height:100%;object-fit:cover}.ai-about-{{ ai_gen_id }}__media-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:{{ block.settings.placeholder_color }}}@media screen and (max-width:749px){.ai-about-{{ ai_gen_id }}{width:100%;margin-top:{{ block.settings.space_top | times:0.7 | round }}px;margin-bottom:{{ block.settings.space_bottom | times:0.7 | round }}px;padding-right:{{ block.settings.mobile_side_padding }}px;padding-left:{{ block.settings.mobile_side_padding }}px}.ai-about-{{ ai_gen_id }}__inner{min-height:0;display:flex;flex-direction:column;align-items:stretch;gap:{{ block.settings.mobile_content_gap }}px}.ai-about-{{ ai_gen_id }}__heading{margin-bottom:18px;font-size:{{ block.settings.heading_size_mobile }}px}.ai-about-{{ ai_gen_id }}__body,.ai-about-{{ ai_gen_id }}__closing{font-size:{{ block.settings.body_size_mobile }}px}.ai-about-{{ ai_gen_id }}__media{width:100%;max-width:none;height:{{ block.settings.image_height_mobile }}px;justify-self:auto}}{% endstyle %}
<section class="ai-about-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-about-{{ ai_gen_id }}__inner"><div class="ai-about-{{ ai_gen_id }}__content">{% if block.settings.eyebrow != blank %}<p class="ai-about-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-about-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.body != blank %}<div class="ai-about-{{ ai_gen_id }}__body">{{ block.settings.body | escape | newline_to_br }}</div>{% endif %}{% if block.settings.closing != blank %}<p class="ai-about-{{ ai_gen_id }}__closing">{{ block.settings.closing | escape }}</p>{% endif %}</div><div class="ai-about-{{ ai_gen_id }}__media">{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-about-{{ ai_gen_id }}__media-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div></div></section>
{% schema %}{"name":"Über DocMed","settings":[{"type":"header","content":"Inhalt"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Über DocMed"},{"type":"text","id":"heading","label":"Überschrift","default":"Medizinische Kompetenz, der Sie vertrauen können"},{"type":"textarea","id":"body","label":"Fließtext","default":"DocMed steht für hochwertige medizinische Produkte, zuverlässige Beratung und Lösungen, die den Alltag in Praxis und Labor spürbar verbessern."},{"type":"text","id":"closing","label":"Abschlusssatz","default":"Gemeinsam schaffen wir Sicherheit in jeder Anwendung."},{"type":"image_picker","id":"image","label":"Bild"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Section-Breite","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"content_max_width","label":"Content-Raster","min":1000,"max":1800,"step":50,"unit":"px","default":1500},{"type":"range","id":"section_height","label":"Section-Höhe","min":300,"max":1000,"step":50,"unit":"px","default":650},{"type":"range","id":"desktop_side_padding","label":"Seitenabstand Desktop","min":0,"max":120,"step":5,"unit":"px","default":20},{"type":"range","id":"mobile_side_padding","label":"Seitenabstand Mobile","min":12,"max":48,"step":4,"unit":"px","default":20},{"type":"range","id":"space_top","label":"Abstand oben","min":0,"max":160,"step":10,"unit":"px","default":80},{"type":"range","id":"space_bottom","label":"Abstand unten","min":0,"max":160,"step":10,"unit":"px","default":80},{"type":"range","id":"text_column_percent","label":"Textanteil","min":35,"max":65,"step":5,"unit":"%","default":50},{"type":"range","id":"column_gap","label":"Spaltenabstand","min":16,"max":120,"step":8,"unit":"px","default":72},{"type":"range","id":"mobile_content_gap","label":"Abstand Mobile","min":16,"max":64,"step":4,"unit":"px","default":36},{"type":"header","content":"Typografie und Bild"},{"type":"range","id":"eyebrow_size","label":"Eyebrow-Größe","min":10,"max":24,"step":1,"unit":"px","default":13},{"type":"range","id":"heading_size_desktop","label":"Überschrift Desktop","min":32,"max":96,"step":4,"unit":"px","default":64},{"type":"range","id":"heading_size_mobile","label":"Überschrift Mobile","min":28,"max":56,"step":2,"unit":"px","default":40},{"type":"range","id":"body_size_desktop","label":"Fließtext Desktop","min":14,"max":24,"step":1,"unit":"px","default":17},{"type":"range","id":"body_size_mobile","label":"Fließtext Mobile","min":14,"max":22,"step":1,"unit":"px","default":16},{"type":"range","id":"image_width","label":"Bildbreite","min":300,"max":1000,"step":50,"unit":"px","default":700},{"type":"range","id":"image_height","label":"Bildhöhe Desktop","min":240,"max":900,"step":30,"unit":"px","default":600},{"type":"range","id":"image_height_mobile","label":"Bildhöhe Mobile","min":180,"max":600,"step":20,"unit":"px","default":360},{"type":"range","id":"image_radius","label":"Bildradius","min":0,"max":32,"step":2,"unit":"px","default":8},{"type":"header","content":"Farben"},{"type":"color","id":"background_color","label":"Hintergrund","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#1D2E40"},{"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#126FD3"},{"type":"color","id":"heading_color","label":"Überschrift","default":"#1D2E40"},{"type":"color","id":"body_color","label":"Fließtext","default":"#1D2E40"},{"type":"color","id":"closing_color","label":"Abschlusssatz","default":"#1D2E40"},{"type":"color","id":"image_placeholder_color","label":"Bildfläche","default":"#F1F5F7"},{"type":"color","id":"placeholder_color","label":"Platzhalter","default":"#6B7C8C"}],"presets":[{"name":"Über DocMed"}],"tag":null,"class":"about-docmed-block"}{% endschema %}