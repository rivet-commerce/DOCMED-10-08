5 Überschrift","default":"Innovation"},{"type":"image_picker","id":"item_6_icon","label":"Feld 6 Icon"},{"type":"text","id":"item_6_title","label":"Feld 6 Überschrift","default":"Vertrauen"}],"presets":[{"name":"Über uns mit Vorteilen"}],"tag":null,"class":"about-benefits-block"}{% endschema %}