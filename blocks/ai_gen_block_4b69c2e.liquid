{% doc %}
  @prompt
    Erstelle eine neue, vollständig responsive, zentrierte Text-Section für meine About-us-Seite.
    
    Die gesamte Section liegt in einem zentrierten Hauptcontainer mit maximal 1500 px Breite, damit sie exakt dieselbe Außenbreite wie meine anderen Sections hat.
    
    Innerhalb dieses Containers befindet sich ein schmalerer Text-Container mittig, dessen maximale Breite separat einstellbar ist (Standard ca. 900 px).
    
    Aufbau: Oben eine große, zweizeilige Überschrift, darunter ein frei bearbeitbarer Rich-Text mit mehreren Absätzen. Der gesamte Inhalt ist horizontal zentriert, auch der Fließtext.
    
    Unter dem Text befindet sich eine kurze, dünne Akzentlinie, ebenfalls mittig. Darunter kann optional ein kurzer Claim/Abschlusstext in Großbuchstaben stehen.
    
    Das Design soll sehr clean und minimalistisch sein: viel Weißraum, keine Box, keine Karte, kein Rahmen, keine Icons und kein Schatten.
    
    Im Shopify-Editor muss alles anpassbar sein: maximale Section-Breite (Standard 1500 px), maximale Textbreite, Section-Höhe/Mindesthöhe, Hintergrundfarbe, Seitenabstand Desktop/Tablet/Mobile, Padding oben/unten, Überschrift, Überschriftgröße separat für Desktop und Mobile, Überschriftfarbe, Fließtext, Textgröße Desktop/Mobile, Textfarbe, Zeilenhöhe, Absatzabstand, Abstand zwischen Überschrift und Text sowie Textausrichtung.
    
    Für die Akzentlinie müssen Breite, Stärke, Farbe und Abstand einstellbar sein. Der optionale Claim darunter benötigt Einstellungen für Text, Schriftgröße, Farbe, Buchstabenabstand und Abstand zur Linie.
    
    Mobile: Der gesamte Inhalt bleibt zentriert. Die Textbreite passt sich automatisch an den Bildschirm an und verwendet den einstellbaren mobilen Seitenabstand. Überschrift und Fließtext dürfen niemals über den Bildschirm hinausragen.
    
    Wichtig: Verwende keine 100vw-Breite. Der äußere Content-Container darf maximal 1500 px breit sein und muss mit margin: 0 auto, width: 100% und box-sizing: border-box zentriert werden.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-about-text-{{ ai_gen_id }}{display:block;width:100%;box-sizing:border-box;background:{{ block.settings.background_color }};min-height:{{ block.settings.min_height }}px;padding:{{ block.settings.padding_top }}px {{ block.settings.mobile_side_padding }}px {{ block.settings.padding_bottom }}px}
  .ai-about-text__container-{{ ai_gen_id }}{width:100%;max-width:{{ block.settings.max_section_width }}px;margin:0 auto;box-sizing:border-box;padding-left:{{ block.settings.desktop_side_padding }}px;padding-right:{{ block.settings.desktop_side_padding }}px}
  .ai-about-text__content-{{ ai_gen_id }}{width:100%;max-width:{{ block.settings.max_text_width }}px;margin:0 auto;text-align:{{ block.settings.text_alignment }};color:{{ block.settings.body_text_color }}}
  .ai-about-text__heading-{{ ai_gen_id }}{margin:0;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size_desktop }}px;line-height:1.08;font-weight:500;overflow-wrap:anywhere}
  .ai-about-text__body-{{ ai_gen_id }}{margin-top:{{ block.settings.heading_text_gap }}px;font-size:{{ block.settings.body_size_desktop }}px;line-height:{{ block.settings.body_line_height }};overflow-wrap:anywhere}
  .ai-about-text__body-{{ ai_gen_id }} p{margin:0 0 {{ block.settings.paragraph_spacing }}px}.ai-about-text__body-{{ ai_gen_id }} p:last-child{margin-bottom:0}
  .ai-about-text__accent-{{ ai_gen_id }}{width:{{ block.settings.accent_width }}px;height:{{ block.settings.accent_thickness }}px;margin:{{ block.settings.accent_spacing }}px auto 0;background:{{ block.settings.accent_color }}}
  .ai-about-text__claim-{{ ai_gen_id }}{margin:{{ block.settings.claim_spacing }}px 0 0;color:{{ block.settings.claim_color }};font-size:{{ block.settings.claim_size }}px;line-height:1.3;letter-spacing:{{ block.settings.claim_letter_spacing }}px;text-transform:uppercase;overflow-wrap:anywhere}
  @media screen and (max-width:989px){.ai-about-text-{{ ai_gen_id }}{padding-left:{{ block.settings.tablet_side_padding }}px;padding-right:{{ block.settings.tablet_side_padding }}px}.ai-about-text__container-{{ ai_gen_id }}{padding-left:0;padding-right:0}}
  @media screen and (max-width:749px){.ai-about-text-{{ ai_gen_id }}{padding-left:{{ block.settings.mobile_side_padding }}px;padding-right:{{ block.settings.mobile_side_padding }}px}.ai-about-text__heading-{{ ai_gen_id }}{font-size:{{ block.settings.heading_size_mobile }}px}.ai-about-text__body-{{ ai_gen_id }}{font-size:{{ block.settings.body_size_mobile }}px}}
{% endstyle %}
<section class="ai-about-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-about-text__container-{{ ai_gen_id }}"><div class="ai-about-text__content-{{ ai_gen_id }}">{% if block.settings.heading != blank %}<h2 class="ai-about-text__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape | newline_to_br }}</h2>{% endif %}{% if block.settings.body_text != blank %}<div class="ai-about-text__body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>{% endif %}<div class="ai-about-text__accent-{{ ai_gen_id }}" aria-hidden="true"></div>{% if block.settings.claim != blank %}<p class="ai-about-text__claim-{{ ai_gen_id }}">{{ block.settings.claim | escape }}</p>{% endif %}</div></div></section>
{% schema %}
{"name":"About text section","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"Built on trust"},{"type":"richtext","id":"body_text","label":"Body text","default":"<p>We bring dependable medical solutions and practical expertise together to support professionals in their daily work.</p><p>Our focus is quality, clarity and long-term partnerships.</p>"},{"type":"text","id":"claim","label":"Claim"},{"type":"header","content":"Layout"},{"type":"range","id":"max_section_width","label":"Maximum section width","min":1000,"max":1500,"step":50,"unit":"px","default":1500},{"type":"range","id":"max_text_width","label":"Maximum text width","min":500,"max":1200,"step":50,"unit":"px","default":900},{"type":"range","id":"min_height","label":"Minimum height","min":0,"max":1000,"step":50,"unit":"px","default":500},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"range","id":"desktop_side_padding","label":"Desktop side padding","min":0,"max":120,"step":10,"unit":"px","default":30},{"type":"range","id":"tablet_side_padding","label":"Tablet side padding","min":0,"max":80,"step":5,"unit":"px","default":25},{"type":"range","id":"mobile_side_padding","label":"Mobile side padding","min":12,"max":48,"step":4,"unit":"px","default":20},{"type":"range","id":"padding_top","label":"Padding top","min":0,"max":200,"step":10,"unit":"px","default":100},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":200,"step":10,"unit":"px","default":100},{"type":"header","content":"Typography"},{"type":"range","id":"heading_size_desktop","label":"Heading size desktop","min":24,"max":96,"step":4,"unit":"px","default":64},{"type":"range","id":"heading_size_mobile","label":"Heading size mobile","min":22,"max":56,"step":2,"unit":"px","default":36},{"type":"range","id":"body_size_desktop","label":"Text size desktop","min":14,"max":28,"step":1,"unit":"px","default":18},{"type":"range","id":"body_size_mobile","label":"Text size mobile","min":14,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"body_line_height","label":"Line height","min":1,"max":2,"step":0.1,"default":1.6},{"type":"range","id":"paragraph_spacing","label":"Paragraph spacing","min":0,"max":48,"step":4,"unit":"px","default":20},{"type":"range","id":"heading_text_gap","label":"Heading to text gap","min":8,"max":80,"step":4,"unit":"px","default":32},{"type":"color","id":"heading_color","label":"Heading color","default":"#1D2E40"},{"type":"color","id":"body_text_color","label":"Text color","default":"#1D2E40"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"header","content":"Accent line"},{"type":"range","id":"accent_width","label":"Width","min":20,"max":200,"step":10,"unit":"px","default":80},{"type":"range","id":"accent_thickness","label":"Thickness","min":1,"max":8,"step":1,"unit":"px","default":2},{"type":"range","id":"accent_spacing","label":"Spacing above","min":20,"max":100,"step":5,"unit":"px","default":50},{"type":"color","id":"accent_color","label":"Color","default":"#7FC7CF"},{"type":"header","content":"Claim"},{"type":"range","id":"claim_size","label":"Size","min":10,"max":24,"step":1,"unit":"px","default":12},{"type":"range","id":"claim_letter_spacing","label":"Letter spacing","min":0,"max":6,"step":0.5,"unit":"px","default":2},{"type":"range","id":"claim_spacing","label":"Spacing above","min":12,"max":60,"step":4,"unit":"px","default":24},{"type":"color","id":"claim_color","label":"Color","default":"#1D2E40"}],"presets":[{"name":"About text section"}],"tag":null,"class":"about-text-block"}
{% endschema %}