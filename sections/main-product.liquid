      },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type" : "Offer",
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {%- endif -%}
            {%- if variant.barcode.size == 12 -%}
              "gtin12": {{ variant.barcode }},
            {%- endif -%}
            {%- if variant.barcode.size == 13 -%}
              "gtin13": {{ variant.barcode }},
            {%- endif -%}
            {%- if variant.barcode.size == 14 -%}
              "gtin14": {{ variant.barcode }},
            {%- endif -%}
            "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price" : {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency" : {{ cart.currency.iso_code | json }},
            "url" : {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

<script type="application/json" id="VariantMetaData-{{ section.id }}">
{
  {%- for v in product.variants -%}
  "{{ v.id }}": {
    "pzn": {{ v.metafields.custom.variant_pzn | json }},
    "ve":  {{ v.metafields.custom.unit | json }},
    "sku": {{ v.sku | json }}
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
}
</script>

<script>
(function () {
  var SECTION = '{{ section.id }}';

  function init() {
    var mapEl = document.getElementById('VariantMetaData-' + SECTION);
    if (!mapEl) return;

    var metaMap = {};
    try { metaMap = JSON.parse(mapEl.textContent || '{}'); } catch (e) { return; }

    // field key -> [container element, text element]
    var fields = {
      pzn: [
        document.getElementById('VariantPzn-' + SECTION),
        document.querySelector('#VariantPzn-' + SECTION + ' [data-pzn-text]')
      ],
      ve: [
        document.getElementById('VariantVe-' + SECTION),
        document.querySelector('#VariantVe-' + SECTION + ' [data-ve-text]')
      ]
    };

    var skuEl = document.getElementById('Sku-' + SECTION);

    function render(variantId) {
      var data = metaMap[String(variantId || '')] || {};

      Object.keys(fields).forEach(function (key) {
        var container = fields[key][0];
        var textEl = fields[key][1];
        if (!container || !textEl) return;

        var value = data[key];
        if (value && String(value).trim() !== '') {
          textEl.textContent = value;
          container.removeAttribute('hidden');
        } else {
          textEl.textContent = '';
          container.setAttribute('hidden', '');
        }
      });

      // SKU sits directly in the <p>, so rewrite only its trailing text node
      if (skuEl) {
        var sku = data.sku;
        if (sku && String(sku).trim() !== '') {
          skuEl.removeAttribute('hidden');
        } else {
          skuEl.setAttribute('hidden', '');
        }
      }
    }

    var form = document.getElementById('product-form-' + SECTION)
           || document.querySelector('form[action*="/cart/add"][data-section="' + SECTION + '"]')
           || document.querySelector('form[action*="/cart/add"]');

    var idInput = form && form.querySelector('input[name="id"]');

    // Initial render — covers page load and deep links to a variant
    if (idInput && idInput.value) render(idInput.value);

    // Theme variant-change events (naming differs between Dawn versions)
    ['variant:change', 'variantChange', 'product:variant-change'].forEach(function (evt) {
      document.addEventListener(evt, function (e) {
        var v = e.detail && (e.detail.variant || e.detail);
        if (v && v.id) render(v.id);
      });
    });

    // Fallback for themes that only update the hidden input
    if (form) {
      form.addEventListener('change', function () {
        if (idInput && idInput.value) render(idInput.value);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

</section>

<script>
  (function () {
    document.querySelectorAll('.shipping-policy-modal').forEach(function (dialog) {
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) dialog.close();
      });
    });
  })();
</script>

